{
  "schema": "okf-repository-publication-contract.v1",
  "modified": "2026-09-15",
  "locale": "en-GB",
  "time_zone": "Europe/London",
  "repository": {
    "name": "okf-dwp",
    "url": "https://github.com/chris-page-gov/okf-dwp",
    "role": "governed-producer",
    "root_index": "README.md",
    "lifecycle": "experimental-preview"
  },
  "semantic_contract": {
    "path": "okf.semantic.json",
    "profile": "https://chris-page-gov.github.io/okf-explorer/profile/bundle-wiki/v1/"
  },
  "source_families": [
    {
      "id": "dwp-public-guidance",
      "label": "DWP public guidance snapshot",
      "description": "36 PDFs linked by the declared GOV.UK publication on 15 September 2026.",
      "kind": "public-document-snapshot",
      "paths": [
        "source/inventory.json",
        "source/pdf/**",
        "source/pages/**",
        "source/text/**",
        "source/extraction-quality.json",
        "source/review-samples.json",
        "knowledge/guided-discovery.yamlld",
        "knowledge/source-navigation.yamlld",
        "domain-profile/**"
      ],
      "formats": [
        "application/pdf",
        "application/json",
        "application/ld+yaml"
      ],
      "origin": "public-govuk-plus-project-authored-navigation",
      "authority": "official-source-with-derived-extraction-and-project-authored-navigation",
      "snapshot_policy": "pinned-revision",
      "inventory": {
        "method": "govuk-content-api-attachment-census",
        "manifest_path": "source/inventory.json",
        "identity": [
          "official-attachment-url",
          "sha256"
        ]
      },
      "rights": {
        "status": "OGL-v3-with-attribution-and-exceptions",
        "evidence": [
          "NOTICE.md",
          "domain-profile/evidence/EV-OGL.json"
        ]
      },
      "sensitivity": {
        "status": "public-source-documents",
        "assessment": "Public guidance and source-authored worked examples; no claimant case data acquired.",
        "evidence": [
          "source/inventory.json"
        ]
      },
      "extraction": {
        "mode": "PDF-page-text",
        "network_access": "explicit-acquisition-only",
        "command_ids": [
          "acquire"
        ],
        "limitations": [
          "Machine text extraction can damage reading order; chapter 83 has known letter-spacing defects."
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "documentation"
      ],
      "limitations": [
        "Snapshot bounded; not a consolidated legal rule set."
      ]
    },
    {
      "id": "cpag-external-reference",
      "label": "CPAG Welfare Benefits Handbook reference",
      "kind": "external-resource-metadata",
      "paths": [
        "knowledge/external-resources.yamlld",
        "docs/cpag-handbook.md",
        "docs/evidence/cpag-access-review.json",
        "docs/evidence/cpag-publication-date-review.json"
      ],
      "formats": [
        "application/ld+yaml",
        "application/json",
        "text/markdown"
      ],
      "origin": "project-authored-reference-to-public-cpag-catalogue",
      "authority": "independent-adviser-publication-reference; no-substantive-content-inspected",
      "snapshot_policy": "dated-public-metadata-review",
      "rights": {
        "status": "metadata-and-links-only; no-handbook-reuse-permission-established",
        "evidence": [
          "docs/cpag-handbook.md",
          "docs/evidence/cpag-access-review.json",
          "NOTICE.md"
        ]
      },
      "limitations": [
        "No CPAG handbook text, pages, rules or tables acquired.",
        "CPAG subscription terms require prior written consent for subscription content in AI tools or automated processes.",
        "This reference is outside the DWP PDF census and the domain profile initial-source denominator."
      ]
    },
    {
      "id": "stage-two-source-discovery",
      "label": "Full DMG, ADM and UC metadata discovery",
      "kind": "public-metadata-snapshot",
      "paths": [
        "source/discovery-2026-09-15/**",
        "knowledge/expanded-source-scope.yamlld"
      ],
      "authority": "official-publication-metadata-with-project-classification",
      "rights": {
        "status": "OGL-v3-with-attribution-and-exceptions",
        "evidence": [
          "source/discovery-2026-09-15/README.md",
          "NOTICE.md"
        ]
      },
      "limitations": [
        "Metadata counts are not PDF acquisition or measured pages.",
        "ADM is a separate source family; UC eligibility is claimant-facing information."
      ]
    },
    {
      "id": "stage-two-semantic-proposals",
      "label": "Source-backed semantic pilot and evaluation design",
      "kind": "project-authored-unreviewed-interpretation",
      "paths": [
        "knowledge/concepts/**",
        "knowledge/rule-candidates.yamlld",
        "knowledge/evaluation-journeys.yamlld",
        "docs/next-stage/**",
        "evaluation/**"
      ],
      "authority": "model-assisted; specialist review pending",
      "rights": {
        "status": "MIT-original-material; OGL-source-passages",
        "evidence": [
          "NOTICE.md",
          "LICENSE"
        ]
      },
      "limitations": [
        "No executable rules or human-approved interpretations.",
        "Projected personas and behavioural evaluations remain unvalidated."
      ]
    },
    {
      "id": "legislation-catalogue-references",
      "label": "Pinned UK legislation catalogue references",
      "kind": "external-resource-metadata",
      "paths": [
        "knowledge/legislation-resources.yamlld"
      ],
      "authority": "project-authored reference to pinned published catalogue",
      "rights": {
        "status": "MIT-original-references; source-level rights apply to linked materials",
        "evidence": [
          "NOTICE.md",
          "docs/next-stage/legislation-integration.md"
        ]
      },
      "limitations": [
        "No statutory provision text or effects acquired here.",
        "Sibling local changes are not an integrated published dependency."
      ]
    },
    {
      "id": "full-dmg-public-guidance",
      "label": "Full DMG public guidance snapshot",
      "kind": "public-document-snapshot",
      "paths": [
        "source/full-dmg-2026-09-15/**",
        "knowledge/full-dmg/**"
      ],
      "authority": "official-source-with-derived-extraction-and-unreviewed-project-interpretation",
      "inventory": {
        "manifest_path": "source/full-dmg-2026-09-15/inventory.json",
        "denominator": 331,
        "census_path": "source/discovery-2026-09-15/census.json"
      },
      "rights": {
        "status": "OGL-v3-with-attribution-and-exceptions",
        "evidence": [
          "NOTICE.md"
        ]
      },
      "limitations": [
        "Acquisition and semantic completion are separate gates; see evaluation/full-dmg-progress.json.",
        "Source publication, observation and legal applicability dates remain distinct.",
        "ADM is separately scoped; no CPAG handbook body content is included."
      ]
    }
  ],
  "boundaries": {
    "authored": [
      {
        "path": "knowledge/**",
        "role": "semantic-input"
      },
      {
        "path": "source/**",
        "role": "frozen-evidence"
      },
      {
        "path": "domain-profile/**",
        "role": "discovery"
      },
      {
        "path": "scripts/**",
        "role": "generator"
      },
      {
        "path": "README.md",
        "role": "documentation"
      },
      {
        "path": "NOTICE.md",
        "role": "rights"
      },
      {
        "path": "CHANGELOG.md",
        "role": "changelog"
      },
      {
        "path": "okf.semantic.json",
        "role": "policy"
      },
      {
        "path": "okf.publication.json",
        "role": "publication-contract"
      },
      {
        "path": ".github/workflows/**",
        "role": "workflow"
      },
      {
        "path": "docs/**",
        "role": "documentation-and-external-source-review"
      },
      {
        "path": "evaluation/**",
        "role": "evaluation-design"
      }
    ],
    "generated": [
      {
        "path": "bundle/**",
        "role": "semantic-and-reader-projections"
      },
      {
        "path": "full-dmg/**",
        "role": "indexed-full-dmg-and-sharded-semantic-projections"
      }
    ]
  },
  "planes": [
    {
      "id": "source",
      "depends_on": [],
      "paths": [
        "source/**"
      ],
      "command_ids": [
        "validate",
        "full-dmg-source-check"
      ]
    },
    {
      "id": "semantic",
      "depends_on": [
        "source"
      ],
      "paths": [
        "knowledge/**",
        "bundle/**",
        "docs/evidence/cpag-access-review.json",
        "scripts/semantic_authoring.py",
        "evaluation/**",
        "docs/evidence/cpag-publication-date-review.json",
        "full-dmg/**"
      ],
      "command_ids": [
        "build-check",
        "validate",
        "full-dmg-evidence-check"
      ]
    },
    {
      "id": "documentation",
      "depends_on": [
        "source",
        "semantic"
      ],
      "paths": [
        "README.md",
        "docs/**",
        "CHANGELOG.md"
      ],
      "command_ids": [
        "diff-check"
      ]
    }
  ],
  "tooling": {
    "commands": [
      {
        "id": "acquire",
        "kind": "build",
        "planes": [
          "source"
        ],
        "command": "uv run --locked python scripts/acquire_sources.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "official-public-govuk",
        "mutates": "source",
        "timeout_minutes": 10
      },
      {
        "id": "build-check",
        "kind": "check",
        "planes": [
          "semantic"
        ],
        "command": "uv run --locked python scripts/build_bundle.py --check",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "validate",
        "kind": "check",
        "planes": [
          "source",
          "semantic"
        ],
        "command": "uv run --locked python scripts/validate_bundle.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "diff-check",
        "kind": "check",
        "planes": [
          "documentation"
        ],
        "command": "git diff --check",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "full-dmg-source-check",
        "kind": "check",
        "planes": [
          "source"
        ],
        "command": "uv run --locked python scripts/acquire_full_dmg.py --check",
        "source": "docs/next-stage/unattended-completion.md",
        "review_status": "project-authored-validation",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "full-dmg-evidence-check",
        "kind": "check",
        "planes": [
          "source",
          "semantic"
        ],
        "command": "uv run --locked python scripts/discover_full_dmg_evidence.py --check",
        "source": "docs/next-stage/unattended-completion.md",
        "review_status": "project-authored-validation",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 5
      }
    ]
  },
  "lockstep": {
    "controlled_paths": [
      "source/**",
      "knowledge/**",
      "domain-profile/**",
      "scripts/**",
      "bundle/**",
      ".github/workflows/**",
      "okf.semantic.json",
      "okf.publication.json",
      "docs/evidence/cpag-access-review.json",
      "evaluation/**",
      "docs/evidence/cpag-publication-date-review.json",
      "full-dmg/**"
    ],
    "documentation_paths": [
      "README.md",
      "REPOSITORY_STATUS.md",
      "CHANGELOG.md"
    ],
    "changelog_path": "CHANGELOG.md",
    "check_command_id": "diff-check",
    "dependency_update_policy": "assess-release-bound-bytes-no-blanket-exemption",
    "unknown_path_policy": "fail-closed"
  },
  "ci": {
    "provider": "github-actions",
    "workflow_paths": [
      ".github/workflows/okf-ci.yml"
    ],
    "impact_routing": "all-preview-checks",
    "parallelism": "single-bounded-job",
    "unknown_path_policy": "run-all",
    "browser": {
      "ordinary": {
        "policy": "not-applicable",
        "engines": [],
        "command_ids": []
      },
      "cross_engine": {
        "policy": "not-applicable",
        "engines": [],
        "command_ids": [],
        "installation": {
          "policy": "none",
          "command_ids": []
        }
      }
    }
  },
  "publication": {
    "mode": "github-repository",
    "scope": "experimental-preview",
    "authority": {
      "decision": "Owner explicitly requested a public chris-page-gov repository and an unofficial meeting exemplar on 15 September 2026. The owner requested the next semantic stage, full DMG target by 24 September and seminar exploration for 30 September. The owner then requested unattended bundle completion; normal reviewed PR publication is authorised.",
      "evidence_paths": [
        "REPOSITORY_STATUS.md"
      ]
    },
    "candidate_policy": "promote-exact-assured-bytes-without-rebuild",
    "targets": [
      {
        "id": "github",
        "url": "https://github.com/chris-page-gov/okf-dwp",
        "kind": "public-repository"
      }
    ]
  },
  "verification": {
    "required": true,
    "browser": "installed-browser",
    "exact_commit_required": true,
    "identity_checks": [
      "bundle title",
      "snapshot id",
      "selected source page"
    ],
    "journeys": [
      "overview",
      "question/pc001",
      "page/84/0035",
      "source PDF link",
      "graph relationships",
      "search"
    ],
    "console_policy": "record-errors",
    "command_ids": []
  },
  "limitations": [
    "Experimental preview contract; full Foundry production gates are not claimed.",
    "The local publication contract is descriptive; semantic schema and all-assertion receipts are separate."
  ]
}
