  "lockstep": {
    "controlled_paths": [
      "source/**",
      "knowledge/**",
      "domain-profile/**",
      "scripts/**",
      "bundle/**",
      ".github/workflows/**",
      "okf.semantic.json",
      "okf.publication.json",
