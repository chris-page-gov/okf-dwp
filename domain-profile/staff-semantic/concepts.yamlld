  key: pension-credit
  '@type':
  - skos:Concept
  - dwp:Benefit
  label: State Pension Credit
  definition: A benefit with Guarantee Credit and Savings Credit components; the captured entitlement
    conditions, household rules and financial assessment must be read together.
  aliases:
  - Pension Credit
  - SPC
