  route: term/capital
  key: capital
  '@type':
  - skos:Concept
  - dwp:AssessmentInput
  label: Capital
  definition: Actual and notional capital, ownership, valuation and disregards precede any deemed-income
    assessment. Savings is not a complete capital definition.
  aliases:
  - savings
  source_candidates:
  - source-c031
  review_status: unreviewed-specialist-review-required
