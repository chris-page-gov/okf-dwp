  key: guarantee-credit
  '@type':
  - skos:Concept
  - dwp:BenefitComponent
  label: Guarantee Credit
  definition: The Guarantee Credit component of Pension Credit has a financial assessment and
    additional-amount dependencies distinct from Savings Credit.
  aliases:
  - GC
  source_candidates:
  - source-c012
  - source-c013
  review_status: unreviewed-specialist-review-required
- '@id': https://chris-page-gov.github.io/okf-dwp/id/term/savings-credit
