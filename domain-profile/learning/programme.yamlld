    {
      "id": "p09",
      "title": "Test whether OKF improves the AI demonstration",
      "demo_ids": [
        1
      ],
      "persona_routes": [
        "persona/knowledge-engineer",
        "persona/evidence-assurance-reviewer",
        "persona/policy-law-reviewer"
      ],
      "prerequisites": [
        "p01",
        "p06"
      ],
      "objective": "Measure token use and evidence quality fairly without presuming the desired result.",
      "assessment": "Publish a paired experiment with complete accounting, blinded claim assessment and failed runs retained.",
      "steps": [
        {
          "title": "State a falsifiable hypothesis",
          "outcome": "Separate token economy from answer quality.",
          "practice": "Pre-register success thresholds and explicitly allow no improvement or worse results.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p09-s01",
          "route": "learning/p09/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Freeze the experiment",
          "outcome": "Keep model, settings, question, source version and output budget comparable.",
          "practice": "Create the input manifest and record unavoidable differences between conditions.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p09-s02",
          "route": "learning/p09/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Choose representative cases",
          "outcome": "Cover ambiguity, dates, interactions and household qualification.",
          "practice": "Select staff-002, 006, 008, 012, 026 and 033 plus an unknown-term control.",
          "evidence_routes": [
            "staff-domain/partner"
          ],
          "question_ids": [
            "staff-002",
            "staff-006",
            "staff-008",
            "staff-012",
            "staff-026",
            "staff-033"
          ],
          "minutes": 3,
          "id": "p09-s03",
          "route": "learning/p09/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Define the controls",
          "outcome": "Distinguish raw-source versus OKF evidence from a no-evidence control.",
          "practice": "Prepare equal-source A/B packages; retain no-evidence as a separate diagnostic, not the fair baseline.",
          "evidence_routes": [
            "term/dmg-evidence-assessment"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p09-s04",
          "route": "learning/p09/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Measure all the costs",
          "outcome": "Count prompts, tool returns, retries, output and amortised preparation separately.",
          "practice": "Submit totals, latency and failure rates for repeated runs, with unavailable provider fields labelled.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p09-s05",
          "route": "learning/p09/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Review claims independently",
          "outcome": "Separate citation match from correctness, qualifications and completeness.",
          "practice": "Blind the treatment labels and score claims against the same frozen evidence.",
          "evidence_routes": [
            "persona/policy-law-reviewer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p09-s06",
          "route": "learning/p09/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Replay and disclose",
          "outcome": "Retain exact identities and explain failures or ties.",
          "practice": "Replay the duplicate and unknown control; retain raw results and exclusions.",
          "evidence_routes": [
            "persona/evidence-assurance-reviewer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p09-s07",
          "route": "learning/p09/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s07",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Comparison assessment",
          "outcome": "Make only conclusions supported by the experiment.",
          "practice": "Submit a paired results table, variability, limitations and a reproducibility manifest.",
          "evidence_routes": [
            "persona/evidence-assurance-reviewer"
          ],
          "question_ids": [],
          "minutes": 6,
          "id": "p09-s08",
          "route": "learning/p09/s08",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p09/s08",
          "@type": "schema:LearningResource"
        }
      ]
    },
    {
      "id": "p10",
      "title": "Design an accessible Pension Credit application journey",
      "demo_ids": [
        2
      ],
      "persona_routes": [
        "persona/applicant-change-reporter",
        "persona/assisted-support",
        "persona/knowledge-engineer",
        "persona/pensions-specialist"
      ],
      "prerequisites": [
        "p01",
        "p04",
        "p06"
      ],
      "objective": "Map an official form and its notes to a synthetic, accessible application flow without equating data collection with entitlement.",
      "assessment": "Submit a versioned field map and a keyboard-complete synthetic journey, with missing form evidence explicitly blocked.",
      "steps": [
        {
          "title": "Set the application boundary",
          "outcome": "Separate a demonstration submission from an official claim.",
          "practice": "Write the opening and confirmation copy; use fictional data and a local demo receipt.",
          "evidence_routes": [
            "persona/applicant-change-reporter"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p10-s01",
          "route": "learning/p10/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Acquire the form family",
          "outcome": "Pin PC1, PC1 notes and PC1H as separate source artefacts.",
          "practice": "Record publication version, original URLs, hashes, page locators and extraction checks.",
          "evidence_routes": [
            "staff-domain/calculation"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p10-s02",
          "route": "learning/p10/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Trace each field",
          "outcome": "Link collected data to an exact form question and purpose.",
          "practice": "Build the form-question to field to validation to conditional-routing matrix.",
          "evidence_routes": [
            "staff-domain/calculation"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p10-s03",
          "route": "learning/p10/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Represent uncertainty",
          "outcome": "Keep unknown, empty, zero and not applicable distinct.",
          "practice": "Create synthetic missing-data cases and explain what the user should do next.",
          "evidence_routes": [
            "staff-domain/eligibility"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p10-s04",
          "route": "learning/p10/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Model household branches",
          "outcome": "Use validated form conditions to design household and care branches.",
          "practice": "Trace two fictional journeys without deriving branches solely from benefit mention tags.",
          "evidence_routes": [
            "staff-domain/partner",
            "staff-domain/care-home"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p10-s05",
          "route": "learning/p10/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Prototype with CASA",
          "outcome": "Choose and pin a tested CASA package and accessible components.",
          "practice": "Retain package identity, route tests, labels, error summary and keyboard results.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p10-s06",
          "route": "learning/p10/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Check answers and corrections",
          "outcome": "Let a person inspect and change every answer before submission.",
          "practice": "Demonstrate correction, cancellation and recovery with consistent state.",
          "evidence_routes": [
            "persona/assisted-support"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p10-s07",
          "route": "learning/p10/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s07",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Application-design assessment",
          "outcome": "Prove field provenance and accessible completion.",
          "practice": "Submit the field map, recordings and fictional receipt; block release if required source fields remain unverified.",
          "evidence_routes": [
            "persona/applicant-change-reporter"
          ],
          "question_ids": [],
          "minutes": 6,
          "id": "p10-s08",
          "route": "learning/p10/s08",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p10/s08",
          "@type": "schema:LearningResource"
        }
      ]
    },
    {
      "id": "p11",
      "title": "Demonstrate a trustworthy agent-assisted application",
      "demo_ids": [
        2
      ],
      "persona_routes": [
        "persona/knowledge-engineer",
        "persona/assisted-support",
        "persona/evidence-assurance-reviewer"
      ],
      "prerequisites": [
        "p10"
      ],
      "objective": "Demonstrate callable browser tools that share validation and user control with the human application flow.",
      "assessment": "Complete the same synthetic case through both routes, prove result parity, consent and failure recovery.",
      "steps": [
        {
          "title": "Verify the host capability",
          "outcome": "Distinguish tool registration from callable WebMCP in the actual host.",
          "practice": "Record browser, host, API and one successful observed discovery/invocation; otherwise label the path blocked.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p11-s01",
          "route": "learning/p11/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Specify a small tool surface",
          "outcome": "Define inspect, update, validate, review and submit operations with clear boundaries.",
          "practice": "Write input/output contracts and state which operations mutate draft or submitted state.",
          "evidence_routes": [
            "persona/rules-architect"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p11-s02",
          "route": "learning/p11/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Share the validation",
          "outcome": "Apply the same rules and state to human and tool-driven entry.",
          "practice": "Submit the same invalid and valid values through both routes and compare outcomes.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p11-s03",
          "route": "learning/p11/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Keep the person in control",
          "outcome": "Bind confirmation to the exact reviewed application state.",
          "practice": "Show a changed answer invalidating earlier confirmation; do not treat conversation text as blanket submission authority.",
          "evidence_routes": [
            "persona/assisted-support"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p11-s04",
          "route": "learning/p11/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Test cancellation and retry",
          "outcome": "Prevent duplicate submission and support recoverable tool failure.",
          "practice": "Demonstrate a cancelled request, retry and one fictional receipt with a stable submission identity.",
          "evidence_routes": [
            "persona/evidence-assurance-reviewer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p11-s05",
          "route": "learning/p11/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Treat content as data",
          "outcome": "Ignore instructions embedded in retrieved guidance or field content.",
          "practice": "Run an inert injection fixture and show that it cannot alter permissions or submission policy.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p11-s06",
          "route": "learning/p11/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Measure parity and cost",
          "outcome": "Compare the same completed application through human and agent routes.",
          "practice": "Report correctness, recovery, calls, tokens and elapsed time without assuming the agent route wins.",
          "evidence_routes": [
            "persona/evidence-assurance-reviewer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p11-s07",
          "route": "learning/p11/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s07",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Agent-assistance assessment",
          "outcome": "Prove callable capability, parity and informed confirmation.",
          "practice": "Submit invocation evidence, a human-route comparison and failed-case logs; provide an honest non-WebMCP fallback if unavailable.",
          "evidence_routes": [
            "persona/assisted-support"
          ],
          "question_ids": [],
          "minutes": 6,
          "id": "p11-s08",
          "route": "learning/p11/s08",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p11/s08",
          "@type": "schema:LearningResource"
        }
      ]
    },
    {
      "id": "p12",
      "title": "From evidence to a reviewable rules prototype",
      "demo_ids": [
        3
      ],
      "persona_routes": [
        "persona/rules-architect",
        "persona/policy-law-reviewer",
        "persona/evidence-assurance-reviewer"
      ],
      "prerequisites": [
        "p04",
        "p05",
        "p06",
        "p07",
        "p09"
      ],
      "objective": "Separate evidence, propositions, reviewed rules and executable tests; block incomplete or unreviewed rules from award decisions.",
      "assessment": "Deliver a non-operational rule specification, traceability and counterexample tests with explicit promotion blockers.",
      "steps": [
        {
          "title": "Challenge definitive-bundle assumptions",
          "outcome": "Explain why a captured guide is not a complete executable legal specification.",
          "practice": "Inventory temporal, statutory, exception and source gaps before defining a rule.",
          "evidence_routes": [
            "persona/rules-architect"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p12-s01",
          "route": "learning/p12/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p12/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Choose one bounded rule family",
          "outcome": "State a small scope and exclude unsupported regimes.",
          "practice": "Propose a Pension Credit input-validation or evidence-routing rule, not a full award calculator.",
          "evidence_routes": [
            "staff-domain/calculation"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p12-s02",
          "route": "learning/p12/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p12/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Extract a proposition",
          "outcome": "Retain conditions, negation, exceptions and source context.",
          "practice": "Write one candidate proposition and link it to exact source passages.",
          "evidence_routes": [
            "term/dmg-evidence-assessment"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p12-s03",
          "route": "learning/p12/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p12/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Record the interpretation",
          "outcome": "Distinguish a source proposition from a model-proposed rule.",
          "practice": "Produce a reviewer decision record with disagreements and unresolved points.",
          "evidence_routes": [
            "persona/policy-law-reviewer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p12-s04",
          "route": "learning/p12/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p12/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Type inputs and outputs",
          "outcome": "Represent dates, units and unknowns explicitly.",
          "practice": "Create a typed decision table with indeterminate and out-of-scope outputs.",
          "evidence_routes": [
            "staff-domain/calculation"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p12-s05",
          "route": "learning/p12/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p12/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Model dates and dependencies",
          "outcome": "Bind rule variants to effective periods and complete support dependencies.",
          "practice": "Show that removing an exception or applicable date blocks evaluation.",
          "evidence_routes": [
            "staff-domain/rates"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p12-s06",
          "route": "learning/p12/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p12/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Create synthetic boundary cases",
          "outcome": "Test neighbouring values and changed material facts.",
          "practice": "Submit positive, negative, missing-data, out-of-period and contradictory-evidence cases.",
          "evidence_routes": [
