          "@type": "schema:LearningResource"
        },
        {
          "title": "Compare with independent review",
          "outcome": "Avoid using the generating model as its own correctness oracle.",
          "practice": "Have a designated reviewer check traceability and expected outcomes; keep specialist approval pending where unavailable.",
          "evidence_routes": [
            "persona/evidence-assurance-reviewer"
