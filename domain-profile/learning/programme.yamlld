  "introduction": "Twelve role-based learning paths connect the three demonstrations to inspectable evidence and assessed practice. Choose relevant paths; the full catalogue is not a single-session course. Personas and learning objectives require user and specialist validation.",
  "paths": [
    {
      "id": "p01",
      "title": "Read evidence before trusting an answer",
      "demo_ids": [
        1,
        2,
        3
      ],
      "persona_routes": [
        "persona/welfare-rights-adviser",
        "persona/pensions-specialist",
        "persona/policy-law-reviewer",
        "persona/evidence-assurance-reviewer",
        "persona/knowledge-engineer",
        "persona/assisted-support"
      ],
      "prerequisites": [],
      "objective": "Build a reproducible claim-to-evidence ledger and stop when the supplied material is insufficient.",
      "assessment": "Classify an unseen evidence package, verify one claim and reject one unsupported claim. All mandatory boundaries must pass.",
      "steps": [
        {
          "title": "Baseline and role",
          "outcome": "State what success looks like for your role.",
          "practice": "Answer three baseline prompts without help; retain them for later comparison.",
          "evidence_routes": [
            "persona/evidence-assurance-reviewer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p01-s01",
          "route": "learning/p01/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Distinguish the layers",
          "outcome": "Separate original guidance, extracted text and project-authored interpretation.",
          "practice": "Classify three items and explain the authority each does and does not have. Compare a page locator with a complete logical evidence unit. Retain its heading, continuations, examples, citations and unresolved dependencies; a smaller passage is not proof of completeness.",
          "evidence_routes": [
            "chapter/77",
            "term/dmg-evidence-assessment"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p01-s02",
          "route": "learning/p01/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Read the source in context",
          "outcome": "Check a paragraph with its heading and continuation.",
          "practice": "Capture the locator and a qualification that would be lost in an isolated quotation.",
          "evidence_routes": [
            "page/77/0020",
            "page/77/0021"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p01-s03",
          "route": "learning/p01/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Use concepts without overclaiming",
          "outcome": "Distinguish a mention tag, semantic assertion and legal applicability.",
          "practice": "Explain why each visible link is or is not enough to support a claim.",
          "evidence_routes": [
            "staff-domain/partner"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p01-s04",
          "route": "learning/p01/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Separate search, context and answer",
          "outcome": "Identify which operation finds records, assembles evidence or generates an answer.",
          "practice": "Draw the three stages and name the artefact returned by each.",
          "evidence_routes": [
            "persona/knowledge-engineer"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p01-s05",
          "route": "learning/p01/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Read insufficiency honestly",
          "outcome": "Distinguish retained candidates, required evidence and unresolved obligations.",
          "practice": "Write three separately defined denominators and identify an omitted requirement.",
          "evidence_routes": [
            "staff-domain/calculation"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p01-s06",
          "route": "learning/p01/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Make the result accessible",
          "outcome": "Explain a result without relying on colour, jargon or pointer-only actions.",
          "practice": "Use keyboard navigation and give a plain-English explanation with one source and one gap.",
          "evidence_routes": [
            "persona/assisted-support"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p01-s07",
          "route": "learning/p01/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s07",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Foundation assessment",
          "outcome": "Apply the evidence rubric independently.",
          "practice": "Submit a claim ledger, a refused unsupported conclusion and a reproducible source identity.",
          "evidence_routes": [
            "term/dmg-evidence-assessment"
          ],
          "question_ids": [],
          "minutes": 6,
          "id": "p01-s08",
          "route": "learning/p01/s08",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p01/s08",
          "@type": "schema:LearningResource"
        }
      ]
    },
    {
      "id": "p02",
      "title": "Absence abroad and residence",
      "demo_ids": [
        1
      ],
      "persona_routes": [
        "persona/welfare-rights-adviser",
        "persona/policy-law-reviewer"
      ],
      "prerequisites": [
        "p01"
      ],
      "objective": "Scope absence questions and expose benefit-specific exceptions without making a universal claim.",
      "assessment": "Pass a changed-duration or changed-purpose case; explicitly re-evaluate applicability.",
      "steps": [
        {
          "title": "Set the scope",
          "outcome": "Name the missing benefit, jurisdiction, dates and purpose.",
          "practice": "Write the minimum clarification questions.",
          "evidence_routes": [
            "staff-domain/abroad"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p02-s01",
          "route": "learning/p02/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p02/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Scope a journey abroad",
          "outcome": "Distinguish the benefit, destination, duration, purpose and relevant period before selecting evidence.",
          "practice": "Create a clarification tree; compare temporary absence, treatment and permanent departure without claiming one universal rule.",
          "evidence_routes": [
            "page/dmg-vol2-ch7-part1/0116",
            "page/dmg-vol2-ch7-part6/0008"
          ],
          "question_ids": [
            "staff-001"
          ],
          "minutes": 4,
          "id": "p02-s02",
          "route": "learning/p02/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p02/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Inspect territorial assumptions",
          "outcome": "Locate the territorial and temporal scope of a candidate passage.",
          "practice": "Annotate what cannot be carried into another jurisdiction.",
          "evidence_routes": [
            "page/dmg-vol2-ch7-part1/0116"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p02-s03",
          "route": "learning/p02/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p02/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Pension Credit and a move abroad",
          "outcome": "Re-scope the general absence question for the named benefit and temporary/permanent distinction.",
          "practice": "Create a benefit-specific evidence plan and explain why the general absence result cannot simply be copied.",
          "evidence_routes": [
            "page/dmg-vol2-ch7-part6/0008",
            "page/77/0014",
            "page/77/0015"
          ],
          "question_ids": [
            "staff-023"
          ],
          "minutes": 4,
          "id": "p02-s04",
          "route": "learning/p02/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p02/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Read continuations",
          "outcome": "Avoid treating the first matching paragraph as the whole rule.",
          "practice": "Follow the chapter context and record a remaining source dependency.",
          "evidence_routes": [
            "document/dmg-vol2-ch7-part6"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p02-s05",
          "route": "learning/p02/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p02/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Change a material fact",
          "outcome": "Explain why a permanent move cannot inherit a temporary-absence conclusion.",
          "practice": "Submit a before/after evidence-requirement table.",
          "evidence_routes": [
            "staff-domain/abroad"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p02-s06",
          "route": "learning/p02/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p02/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Absence assessment",
          "outcome": "Give a qualified evidence plan for an unseen absence scenario.",
          "practice": "Submit scope, sources, exceptions and an escalation decision.",
          "evidence_routes": [
            "persona/policy-law-reviewer"
          ],
          "question_ids": [],
          "minutes": 6,
          "id": "p02-s07",
          "route": "learning/p02/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p02/s07",
          "@type": "schema:LearningResource"
        }
      ]
    },
    {
      "id": "p03",
      "title": "Pension regimes, age and transitions",
      "demo_ids": [
        1
      ],
      "persona_routes": [
        "persona/pensions-specialist",
        "persona/policy-law-reviewer"
      ],
      "prerequisites": [
        "p01"
      ],
      "objective": "Separate age, regime, conditions, claim and payment across State Pension and disability transitions.",
      "assessment": "Classify an unseen transition without equating age with entitlement or first payment.",
      "steps": [
        {
          "title": "Create a regime map",
          "outcome": "Separate new State Pension from the legacy regime.",
          "practice": "Draw two source branches and list the date needed to choose between them.",
          "evidence_routes": [
            "staff-domain/new-state-pension",
            "staff-domain/retirement-pension"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p03-s01",
          "route": "learning/p03/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Separate age from first entitlement",
          "outcome": "Distinguish pensionable age, qualifying conditions, claim and payment dates.",
          "practice": "For the supplied birth-date example, mark which date questions the captured table can support and which need further evidence; do not produce an entitlement decision.",
          "evidence_routes": [
            "page/dmg-vol12-ch74/0003",
            "page/dmg-vol12-ch74/0068",
            "page/dmg-vol12-ch74/0011",
            "page/dmg-vol12-ch74/0015"
          ],
          "question_ids": [
            "staff-002"
          ],
          "minutes": 4,
          "id": "p03-s02",
          "route": "learning/p03/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Separate pension regimes and components",
          "outcome": "Identify new State Pension, legacy retirement pension and transitional evidence as different scopes.",
          "practice": "Produce a regime-and-component map with source-backed prerequisites and an unresolved NI-record boundary.",
          "evidence_routes": [
            "page/dmg-vol12-ch74/0001",
            "page/dmg-vol12-ch74/0011",
            "page/dmg-vol12-ch74/0015"
          ],
          "question_ids": [
            "staff-004"
          ],
          "minutes": 4,
          "id": "p03-s03",
          "route": "learning/p03/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "IIDB around pension age",
          "outcome": "Distinguish IIDB from Reduced Earnings Allowance and related age-dependent questions.",
          "practice": "Create a transition table with independent evidence requirements for each named benefit.",
          "evidence_routes": [
            "page/dmg-vol11-ch69/0003",
            "page/dmg-vol11-ch71/0117",
            "page/dmg-vol12-ch74/0001",
            "page/dmg-vol3-ch17/0011"
          ],
          "question_ids": [
            "staff-025"
          ],
          "minutes": 4,
          "id": "p03-s04",
          "route": "learning/p03/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "PIP around pension age",
          "outcome": "Distinguish the treatment of an existing award from a new claim at a different date.",
          "practice": "Submit a change-of-facts counterexample and the evidence it requires.",
          "evidence_routes": [
            "page/dmg-vol10-ch61/0005",
            "page/dmg-vol12-ch74/0003"
          ],
          "question_ids": [
            "staff-032"
          ],
          "minutes": 4,
          "id": "p03-s05",
          "route": "learning/p03/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Audit the age table",
          "outcome": "Preserve the table heading, band and continuation.",
          "practice": "Explain what the table establishes and what it does not establish.",
          "evidence_routes": [
            "page/dmg-vol12-ch74/0068"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p03-s06",
          "route": "learning/p03/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Remove the date",
          "outcome": "Recognise when an answer becomes unsupported after a date or regime is removed.",
          "practice": "Reject or qualify a deliberately under-specified synthetic case.",
          "evidence_routes": [
            "staff-domain/pension-age"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p03-s07",
          "route": "learning/p03/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s07",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Transition assessment",
          "outcome": "Present a regime-aware evidence brief.",
          "practice": "Submit a timeline separating qualification, claim, award and payment.",
          "evidence_routes": [
            "staff-domain/payment"
          ],
          "question_ids": [],
          "minutes": 6,
          "id": "p03-s08",
          "route": "learning/p03/s08",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p03/s08",
          "@type": "schema:LearningResource"
        }
      ]
    },
    {
      "id": "p04",
      "title": "Pension Credit inputs and calculation structure",
      "demo_ids": [
        1,
        2,
        3
      ],
      "persona_routes": [
        "persona/pensions-specialist",
        "persona/rules-architect",
        "persona/evidence-assurance-reviewer"
      ],
      "prerequisites": [
        "p01"
      ],
      "objective": "Explain Pension Credit assessment dependencies without turning incomplete guidance into an award calculator.",
      "assessment": "Submit an input dictionary and dependency graph with typed unknowns, dated parameters and unresolved obligations.",
      "steps": [
        {
          "title": "Distinguish the decisions",
          "outcome": "Separate eligibility, inputs, components and payable amount.",
          "practice": "Sketch four boxes and the evidence each requires.",
          "evidence_routes": [
            "staff-domain/calculation"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p04-s01",
          "route": "learning/p04/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Explain Pension Credit clearly",
          "outcome": "Give a plain-English structural explanation while separating source statements from interpretation.",
          "practice": "Write a short explanation and an evidence ledger; retain limitations instead of hiding them in a footnote.",
          "evidence_routes": [
            "page/77/0014",
            "page/77/0033",
            "page/77/0035",
            "page/84/0128",
            "page/85/0030"
          ],
          "question_ids": [
            "staff-019"
          ],
          "minutes": 4,
          "id": "p04-s02",
          "route": "learning/p04/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Trace qualification conditions",
          "outcome": "Separate demonstrated conditions from assumptions about facts, dates and regime.",
          "practice": "Create a conditions-and-evidence checklist with an explicit cannot-determine outcome.",
          "evidence_routes": [
            "page/77/0014",
            "page/77/0015",
            "page/77/0026",
            "page/77/0033"
          ],
          "question_ids": [
            "staff-020"
          ],
          "minutes": 4,
          "id": "p04-s03",
          "route": "learning/p04/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Challenge the savings-maximum premise",
          "outcome": "Distinguish capital, valuation, disregards and income treatment from a single assumed cut-off.",
          "practice": "Create a dependency map; label missing conditions rather than returning a universal savings maximum.",
          "evidence_routes": [
            "page/84/0128",
            "page/77/0033",
            "page/77/0014"
          ],
          "question_ids": [
            "staff-006"
          ],
          "minutes": 4,
          "id": "p04-s04",
          "route": "learning/p04/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Map assessment elements",
          "outcome": "Separate an input, an eligibility condition and a calculation parameter.",
          "practice": "Classify every proposed threshold and identify the source, period and unresolved dependency.",
          "evidence_routes": [
            "page/77/0014",
            "page/77/0033",
            "page/77/0035",
            "page/84/0128",
            "page/85/0030"
          ],
          "question_ids": [
            "staff-010"
          ],
          "minutes": 4,
          "id": "p04-s05",
          "route": "learning/p04/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Specify calculation inputs",
          "outcome": "Trace proposed inputs to their purpose, evidence and applicability.",
          "practice": "Produce an input dictionary that separates unknown, zero, not applicable and not supplied.",
          "evidence_routes": [
            "page/77/0014",
            "page/77/0033",
            "page/77/0035",
            "page/84/0128",
            "page/85/0030"
          ],
          "question_ids": [
            "staff-015"
          ],
          "minutes": 4,
          "id": "p04-s06",
          "route": "learning/p04/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Describe calculation dependencies",
          "outcome": "Represent the structure of a calculation without treating an incomplete source package as an executable formula.",
          "practice": "Draw a dependency graph with units, effective periods and unresolved branches; do not calculate an award.",
          "evidence_routes": [
            "page/77/0033",
            "page/77/0035",
            "page/84/0128",
            "page/85/0030"
          ],
          "question_ids": [
            "staff-016"
          ],
          "minutes": 4,
          "id": "p04-s07",
          "route": "learning/p04/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s07",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Separate eligibility from rate",
          "outcome": "Keep the qualifying test, component and dated rate as distinct evidence needs.",
          "practice": "Prepare a review brief that cannot collapse these three decisions into one lookup.",
          "evidence_routes": [
            "page/77/0014",
            "page/77/0015",
            "page/77/0033",
            "page/77/0059",
            "page/77/0060",
            "page/77/0061",
            "page/77/0062",
            "page/77/0063",
            "page/77/0064",
            "page/77/0065",
            "page/77/0066",
            "page/77/0067",
            "page/77/0068",
            "page/77/0044",
            "page/dmg-memo-02-26-f7835f1e40/0002"
          ],
          "question_ids": [
            "staff-021"
          ],
          "minutes": 4,
          "id": "p04-s08",
          "route": "learning/p04/s08",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s08",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Test a misleading threshold",
          "outcome": "Detect a capital example being presented as a universal maximum.",
          "practice": "Repair the claim and show the missing valuation or disregard dependency.",
          "evidence_routes": [
            "term/capital-valuation",
            "term/capital-disregards"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p04-s09",
          "route": "learning/p04/s09",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p04/s09",
          "@type": "schema:LearningResource"
        },
        {
