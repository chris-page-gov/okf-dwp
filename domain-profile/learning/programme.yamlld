    {
      "id": "p08",
      "title": "Caring conditions and effects on others",
      "demo_ids": [
        1
      ],
      "persona_routes": [
        "persona/welfare-rights-adviser",
        "persona/evidence-assurance-reviewer"
      ],
      "prerequisites": [
        "p01"
      ],
      "objective": "Separate caring conditions, qualifying payments and interactions without assuming multiple awards.",
      "assessment": "Reject a doubled-payment inference and distinguish effects on the carer from effects on another person.",
      "steps": [
        {
          "title": "Distinguish the people and payments",
          "outcome": "Separate carer, cared-for person, Carer’s Allowance and a carer additional amount.",
          "practice": "Draw a labelled people-and-payments diagram.",
          "evidence_routes": [
            "staff-domain/carers-allowance",
            "staff-domain/carer-addition"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p08-s01",
          "route": "learning/p08/s01",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p08/s01",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Caring qualification",
          "outcome": "Identify source-backed caring conditions separately from evidence that they are met.",
          "practice": "Build a conditions-to-evidence checklist using only synthetic facts.",
          "evidence_routes": [
            "page/dmg-vol10-ch60/0003",
            "page/dmg-vol10-ch60/0004"
          ],
          "question_ids": [
            "staff-038"
          ],
          "minutes": 4,
          "id": "p08-s02",
          "route": "learning/p08/s02",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p08/s02",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Caring interactions",
          "outcome": "Distinguish Carer’s Allowance from a Pension Credit carer addition and impacts on another person.",
          "practice": "Draw directed claimant/carer/other-person effects and test an unsupported symmetry claim.",
          "evidence_routes": [
            "page/dmg-vol10-ch60/0003",
            "page/dmg-vol10-ch60/0004",
            "page/78/0027",
            "page/78/0011",
            "page/dmg-vol3-ch17/0011"
          ],
          "question_ids": [
            "staff-039"
          ],
          "minutes": 4,
          "id": "p08-s03",
          "route": "learning/p08/s03",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p08/s03",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Caring for several people",
          "outcome": "Avoid inferring multiple payments from multiple caring responsibilities.",
          "practice": "Compare one-person and two-person synthetic scenarios and justify every proposed change or non-conclusion.",
          "evidence_routes": [
            "page/dmg-vol10-ch60/0007",
            "page/dmg-vol10-ch60/0003",
            "page/dmg-vol10-ch60/0004"
          ],
          "question_ids": [
            "staff-040"
          ],
          "minutes": 4,
          "id": "p08-s04",
          "route": "learning/p08/s04",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p08/s04",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Evidence of caring",
          "outcome": "Distinguish a condition from evidence that a synthetic case meets it.",
          "practice": "Create an evidence checklist and identify unknown facts.",
          "evidence_routes": [
            "term/ca-care-statement-evidence"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p08-s05",
          "route": "learning/p08/s05",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p08/s05",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Change the qualifying payment",
          "outcome": "Re-evaluate dependencies when one relevant fact changes.",
          "practice": "Record which conclusions must be withdrawn or rechecked.",
          "evidence_routes": [
            "term/ca-qualifying-disability-payment"
          ],
          "question_ids": [],
          "minutes": 3,
          "id": "p08-s06",
          "route": "learning/p08/s06",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p08/s06",
          "@type": "schema:LearningResource"
        },
        {
          "title": "Caring assessment",
          "outcome": "Give a supported scope statement and a safe next step.",
          "practice": "Submit the directed map, source locators and unresolved evidence.",
          "evidence_routes": [
            "persona/welfare-rights-adviser"
          ],
          "question_ids": [],
          "minutes": 6,
          "id": "p08-s07",
          "route": "learning/p08/s07",
          "@id": "https://chris-page-gov.github.io/okf-dwp/id/learning/p08/s07",
          "@type": "schema:LearningResource"
        }
