  body: "8\nSchedule III shall have effect in the case of members of polygamous marriages and persons
    serving a sentence of imprisonment detained in hospital."
  context_assembly:
    kind: evidence
    text: "8\nSchedule III shall have effect in the case of members of polygamous marriages and persons
      serving a sentence of imprisonment detained in hospital."
