  title: uksi/2002/1792/regulation/15 — Income / Income for the purposes of the Act
  type: Statutory body evidence
  status: draft
  authority: Machine extraction from official legislation publication; unreviewed
  review_status: unreviewed
  resource: https://www.legislation.gov.uk/uksi/2002/1792/regulation/15/2026-09-20
