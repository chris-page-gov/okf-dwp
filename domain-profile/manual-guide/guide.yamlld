      "category": "document-role",
      "statement": "DMG Volume 1 Amendment 59 states that changes were already incorporated in internet/intranet guidance and includes a Remove / Insert table for printed packages.",
      "reading_implication": "Treat this as historical amendment-package evidence. Do not promote a repeated rule excerpt in the package to an independent current rule; printing instructions stay inert.",
      "assertion_status": "project-authored-source-linked",
      "confidence": "direct-source-statement",
      "scope": {
