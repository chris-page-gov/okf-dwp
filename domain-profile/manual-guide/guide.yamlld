      "reading_implication": "Scope and source routing cross both chapter and manual boundaries. Follow applicable routes while keeping unresolved regime and temporal questions visible.",
      "assertion_status": "project-authored-source-linked",
      "confidence": "direct-source-statement",
      "scope": {
