  "profiles": [
    {
      "id": "https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/pc-household-routing",
      "label": "Pension Credit: partner and household context routes",
      "when_all": [
        "https://chris-page-gov.github.io/okf-dwp/id/term/pension-credit",
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/partner"
      ],
      "covers": [
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/partner"
      ],
      "required_unit_keys": [
        "household-dmg-77013",
        "household-dmg-77015",
        "household-dmg-77100",
        "household-dmg-77102",
        "household-dmg-77115",
        "household-dmg-77117",
        "household-dmg-77121",
        "household-dmg-77122",
        "household-dmg-77123",
        "household-dmg-77035",
        "household-dmg-77140",
        "household-dmg-77350",
        "household-dmg-85016"
      ],
      "scope": "Introductory partner/household research only. Retain the distinction between sharing a dwelling and being a household; source-defined couple and partner; conditional separation/exceptions; different mixed-age definitions; and partner-income attribution with its stated exception. These passages do not establish every care-home, absence, component, capital or migration outcome. No claimant facts are supplied and no award or complete answer is inferred.",
      "missing_obligations": [
        {
          "key": "applicability",
          "category": "applicability_unresolved",
          "label": "Benefit variant, relevant date, residence, household and claimant facts remain unresolved; source capture is not legal applicability.",
          "status": "not-established"
        },
        {
          "key": "legal-version",
          "category": "legal_version_unreconciled",
          "label": "Applicable amendments, commencement and cited legal sources have not been reconciled.",
          "status": "not-established"
        },
        {
          "key": "specialist-review",
          "category": "independent_review_pending",
          "label": "Model-assisted source selection and machine boundaries have not received specialist acceptance.",
          "status": "not-reviewed"
        },
        {
          "key": "household-facts",
          "category": "question_scope_unresolved",
          "label": "Partner ages, relationship, domestic establishment, previous household membership, intent, expected/actual absence, immigration status and relevant date are unspecified. Presence of a partner word is not proof of a legally relevant couple or shared household.",
          "status": "not-established"
        },
        {
          "key": "conditional-household-branches",
          "category": "evidence_closure_unverified",
          "label": "Full scope of the source branches remains unclosed: temporary absence/death/treatment qualifications in DMG 77118–77120; both-partner care-home domestic-establishment assessment in DMG 77128–77130; detention, special-hospital, overseas and immigration rules; and their cited definitions and legislation. Selecting the introductory exclusions does not establish any branch for this task.",
          "status": "not-established"
        },
        {
          "key": "source-reference-discrepancy",
          "category": "evidence_closure_unverified",
          "label": "The frozen DMG 77117, point 1.2, names DMG 77119 for the exception to absence exceeding 52 weeks. The captured DMG 77119 concerns an eight-week death-related absence; DMG 77122 expressly addresses the 52-week exception. Preserve and review this source-reference discrepancy; do not silently correct or infer its legal effect.",
          "status": "not-established"
        },
        {
          "key": "mixed-age-and-migration",
          "category": "evidence_closure_unverified",
