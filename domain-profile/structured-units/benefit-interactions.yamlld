  "profiles": [
    {
      "id": "https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/iidb-additional-benefit-routes",
      "label": "IIDB: scheme components and conditional supplement routes",
      "when_all": [
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/iidb",
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/additional-benefits"
      ],
      "covers": [
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/iidb",
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/additional-benefits"
      ],
      "required_unit_keys": [
        "interaction-dmg-64007",
        "interaction-dmg-64012",
        "interaction-dmg-64020",
        "interaction-dmg-64023",
        "interaction-dmg-64026",
        "interaction-dmg-64029",
        "interaction-dmg-64035",
        "interaction-dmg-69310",
        "interaction-dmg-69320",
        "interaction-dmg-71010"
      ],
      "scope": "Distinguish basic IIDB from the industrial scheme’s CAA, ESDA, REA, RA and retained US. Selected conditions make the introductions conditional, not automatic additional awards. This profile does not enumerate every benefit or service associated with disability.",
      "missing_obligations": [
        {
          "key": "applicability",
          "category": "applicability_unresolved",
          "label": "Relevant date, jurisdiction, claimant and household facts, exact benefit/component and legacy, New Style or devolved regime are unresolved. Source capture and a matching concept do not establish applicability.",
          "status": "not-established"
        },
        {
          "key": "legal-version",
          "category": "legal_version_unreconciled",
          "label": "Cited legislation, amendments, commencement, memo overlays, supersession and relevant-date rates require separate reconciliation; the frozen source is not automatically current law.",
          "status": "not-established"
        },
        {
          "key": "specialist-review",
          "category": "independent_review_pending",
          "label": "Agent source-reading and exact text/identity checks are not specialist acceptance. Machine boundaries, references and resulting legal conclusions remain unreviewed.",
          "status": "not-reviewed"
        },
        {
          "key": "additional-scope",
          "category": "question_scope_unresolved",
          "label": "Additional benefits is unbounded. CAA attendance interpretation/rate conditions, ESDA higher-rate conditions, full REA occupation/date assessment, RA transition, retained US history and other means-tested benefits each need separately scoped evidence. Industrial CAA is not War Pensions CAA.",
          "status": "not-established"
        },
        {
          "key": "qualifying-facts",
          "category": "evidence_closure_unverified",
          "label": "Accident or disease date, assessed disablement, actual attendance needs, relevant loss of faculty, occupation and earnings, claim date and existing industrial supplements are unspecified. DMG 69322 onwards and other referred conditions remain unclosed.",
          "status": "not-established"
        },
        {
          "key": "us-date-wording",
          "category": "legal_version_unreconciled",
          "label": "The frozen US wording differs: DMG 64020 says no new claims could be made from 8.4.87, while DMG 28065 and 51033 say the supplement was removed from the scheme on 6.4.87 but could continue in payment. Preserve both dates and descriptions as potentially different events; do not silently normalise them to a single closure date.",
          "status": "not-established"
        }
      ],
      "assertion_status": "model-derived",
      "review_status": "unreviewed-specialist-review-required",
      "answerability": "insufficient-until-open-obligations-resolved"
    },
    {
      "id": "https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/iidb-pension-age-routes",
      "label": "IIDB: pension-age questions and distinct REA/RA transitions",
      "when_all": [
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/iidb",
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/pension-age"
      ],
      "covers": [
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/iidb",
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/pension-age"
      ],
      "required_unit_keys": [
        "interaction-dmg-64007",
        "interaction-dmg-64012",
        "interaction-dmg-64029",
        "interaction-dmg-64035",
        "interaction-dmg-71099",
        "interaction-dmg-71747",
        "interaction-dmg-71764",
        "interaction-dmg-71765",
        "interaction-dmg-71766",
        "interaction-dmg-71771",
        "interaction-dmg-71772",
        "interaction-dmg-71773",
        "interaction-dmg-71774",
        "interaction-dmg-71775",
        "interaction-dmg-71776",
        "interaction-dmg-71777",
        "interaction-dmg-71778",
        "interaction-dmg-71779",
        "interaction-dmg-71782",
        "interaction-dmg-71783"
      ],
      "scope": "Retain the source distinction between IIDB, REA, RA and RP/SP. Include the post-1989 and post-1996 regular-employment branches, first-claim qualification, full six-example unit, payment timing and rate restrictions. Historical examples and formulae are evidence, not present-day calculations.",
      "missing_obligations": [
        {
          "key": "applicability",
          "category": "applicability_unresolved",
          "label": "Relevant date, jurisdiction, claimant and household facts, exact benefit/component and legacy, New Style or devolved regime are unresolved. Source capture and a matching concept do not establish applicability.",
          "status": "not-established"
        },
        {
          "key": "legal-version",
          "category": "legal_version_unreconciled",
          "label": "Cited legislation, amendments, commencement, memo overlays, supersession and relevant-date rates require separate reconciliation; the frozen source is not automatically current law.",
          "status": "not-established"
        },
        {
          "key": "specialist-review",
          "category": "independent_review_pending",
          "label": "Agent source-reading and exact text/identity checks are not specialist acceptance. Machine boundaries, references and resulting legal conclusions remain unreviewed.",
          "status": "not-reviewed"
        },
        {
          "key": "pension-regime",
          "category": "question_scope_unresolved",
          "label": "A question about IIDB at State Pension age does not establish that REA or RA is in payment. Identify the actual component, date, accident/disease and claim history, regular employment and State Pension/RP regime. DMG Chapters 74 and 75 pension-age definitions require their own routes.",
          "status": "not-established"
        },
        {
          "key": "historic-exceptions",
          "category": "evidence_closure_unverified",
          "label": "The earlier retirement/frozen REA branches in DMG 71748–71762, historic regular-employment treatment in 71767–71770, full REA award conditions and their cited law are not closed. DMG 71773 expressly preserves frozen REA; this profile does not generalise the later branch to it.",
          "status": "not-established"
        },
        {
          "key": "rate-date",
          "category": "evidence_closure_unverified",
          "label": "DMG 71779 gives a conditional formula, not a current award. Relevant-date maximum rates, the individual earlier REA award, rounding and interacting restrictions remain unresolved.",
          "status": "not-established"
        }
      ],
      "assertion_status": "model-derived",
      "review_status": "unreviewed-specialist-review-required",
      "answerability": "insufficient-until-open-obligations-resolved"
    },
    {
      "id": "https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/iidb-jsa-income-and-overlap",
      "label": "IIDB and JSA: income-based treatment and scoped overlap leads",
      "when_all": [
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/iidb",
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/jsa"
      ],
      "covers": [
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/iidb",
        "https://chris-page-gov.github.io/okf-dwp/id/staff-domain/jsa"
      ],
      "required_unit_keys": [
        "interaction-dmg-17001",
        "interaction-dmg-17005",
        "interaction-dmg-17040",
        "interaction-dmg-17085",
        "interaction-dmg-17086",
        "interaction-dmg-28050",
        "interaction-dmg-28065",
        "interaction-dmg-28066",
        "interaction-dmg-28352",
        "interaction-dmg-28353"
      ],
      "scope": "DMG Chapter 28 expressly scopes the income treatment to IS/JSA(IB), distinguishes basic IIDB/REA/US from attendance additions and retains the statutory meaning of attendance allowance. Chapter 17 is a separate payment-adjustment plane. Do not transfer JSA(IB) means-test rules to contributory or New Style JSA.",
      "missing_obligations": [
        {
          "key": "applicability",
          "category": "applicability_unresolved",
          "label": "Relevant date, jurisdiction, claimant and household facts, exact benefit/component and legacy, New Style or devolved regime are unresolved. Source capture and a matching concept do not establish applicability.",
          "status": "not-established"
        },
        {
          "key": "legal-version",
          "category": "legal_version_unreconciled",
          "label": "Cited legislation, amendments, commencement, memo overlays, supersession and relevant-date rates require separate reconciliation; the frozen source is not automatically current law.",
          "status": "not-established"
        },
        {
          "key": "specialist-review",
          "category": "independent_review_pending",
          "label": "Agent source-reading and exact text/identity checks are not specialist acceptance. Machine boundaries, references and resulting legal conclusions remain unreviewed.",
          "status": "not-reviewed"
        },
        {
          "key": "concurrent-entitlement",
          "category": "evidence_closure_unverified",
          "label": "Separate entitlement to each benefit, compatibility, payment adjustment and income treatment. This source selection does not prove concurrent entitlement from the absence of a benefit in an overlap list. Full contribution, capability/availability, income, capital, household and migration conditions remain open.",
          "status": "not-established"
        },
        {
          "key": "jsa-variant",
          "category": "question_scope_unresolved",
          "label": "JSA variant, receipt of industrial supplements, contribution and labour-market conditions, relevant date and claim/migration history are unspecified. The Chapter 17 New Style inclusion has its own limited scope and does not settle a general yes/no concurrent-entitlement question.",
          "status": "not-established"
        },
        {
          "key": "income-closure",
          "category": "evidence_closure_unverified",
          "label": "Full income attribution, time periods, notional or unpaid income, capital conversion, other disregards, transitional rules and DMG memo IS/JSA 64 remain unclosed.",
          "status": "not-established"
        },
        {
          "key": "us-date-wording",
          "category": "legal_version_unreconciled",
          "label": "The frozen US wording differs: DMG 64020 says no new claims could be made from 8.4.87, while DMG 28065 and 51033 say the supplement was removed from the scheme on 6.4.87 but could continue in payment. Preserve both dates and descriptions as potentially different events; do not silently normalise them to a single closure date.",
          "status": "not-established"
        }
      ],
      "assertion_status": "model-derived",
      "review_status": "unreviewed-specialist-review-required",
      "answerability": "insufficient-until-open-obligations-resolved"
    },
