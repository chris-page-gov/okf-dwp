{"@context":{"@vocab":"https://chris-page-gov.github.io/okf-dwp/vocab/structured-context-selection/","dct":"http://purl.org/dc/terms/","prov":"http://www.w3.org/ns/prov#"},"@id":"https://chris-page-gov.github.io/okf-dwp/id/authoring/structured-units/state-pension-routing","assertion_status":"model-derived","profiles":[{"answerability":"insufficient-until-open-obligations-resolved","assertion_status":"model-derived","covers":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension"],"id":"https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/state-pension-regime","label":"State Pension: regime and rate-branch orientation","missing_obligations":[{"category":"applicability_unresolved","key":"applicability","label":"Regime, relevant date, territory, claim and claimant facts remain unresolved. Guidance is not an individual entitlement decision.","status":"not-established"},{"category":"legal_version_unreconciled","key":"legal-version","label":"Cited legal sources, amendments and commencement have not been reconciled; captured guidance and illustrative rates are not current-law certification.","status":"not-established"},{"category":"independent_review_pending","key":"specialist-review","label":"Source selection and machine boundaries require specialist review.","status":"not-reviewed"},{"category":"evidence_closure_unverified","key":"task-closure","label":"Introductory State Pension sources do not establish overlapping payments, other benefits, PIP continuation, full component calculations, deferral or all special groups.","status":"not-established"}],"required_unit_keys":["dmg-74001","dmg-74011","dmg-74012"],"review_status":"unreviewed-specialist-review-required","scope":"Source orientation for the legislative new State Pension: distinguish retirement pension, full/reduced/transitional rate branches and contribution-record disputes. This is not full evidence for the question-specific interaction, entitlement or calculation.","when_all":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension"]},{"answerability":"insufficient-until-open-obligations-resolved","assertion_status":"model-derived","covers":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension","https://chris-page-gov.github.io/okf-dwp/id/staff-domain/pension-age"],"id":"https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/state-pension-age","label":"State Pension: pensionable age and transition tables","missing_obligations":[{"category":"applicability_unresolved","key":"applicability","label":"Regime, relevant date, territory, claim and claimant facts remain unresolved. Guidance is not an individual entitlement decision.","status":"not-established"},{"category":"legal_version_unreconciled","key":"legal-version","label":"Cited legal sources, amendments and commencement have not been reconciled; captured guidance and illustrative rates are not current-law certification.","status":"not-established"},{"category":"independent_review_pending","key":"specialist-review","label":"Source selection and machine boundaries require specialist review.","status":"not-reviewed"},{"category":"evidence_closure_unverified","key":"task-closure","label":"Introductory State Pension sources do not establish overlapping payments, other benefits, PIP continuation, full component calculations, deferral or all special groups.","status":"not-established"},{"category":"evidence_closure_unverified","key":"entitlement-not-age","label":"Reaching pensionable age is not proof of contribution entitlement, a valid claim, the first payable day or the first payment. Scope outside the captured age definition, overseas records and deferral remain separate.","status":"not-established"}],"required_unit_keys":["dmg-74022","dmg-74-appendix-1","dmg-74-appendix-2","dmg-74-appendix-3","dmg-74-appendix-4"],"review_status":"unreviewed-specialist-review-required","scope":"Select the complete pensionable-age definition and all four referenced appendices, including cohort headings and the end-of-month note. Keep their distinct cohort and sex scopes; no question-specific date chooses the table. Do not calculate an individual entitlement or first-payment date.","when_all":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension","https://chris-page-gov.github.io/okf-dwp/id/staff-domain/pension-age"]},{"answerability":"insufficient-until-open-obligations-resolved","assertion_status":"model-derived","covers":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension","https://chris-page-gov.github.io/okf-dwp/id/staff-domain/eligibility"],"id":"https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/state-pension-qualification","label":"State Pension: full, reduced and transitional qualification branches","missing_obligations":[{"category":"applicability_unresolved","key":"applicability","label":"Regime, relevant date, territory, claim and claimant facts remain unresolved. Guidance is not an individual entitlement decision.","status":"not-established"},{"category":"legal_version_unreconciled","key":"legal-version","label":"Cited legal sources, amendments and commencement have not been reconciled; captured guidance and illustrative rates are not current-law certification.","status":"not-established"},{"category":"independent_review_pending","key":"specialist-review","label":"Source selection and machine boundaries require specialist review.","status":"not-reviewed"},{"category":"evidence_closure_unverified","key":"task-closure","label":"Introductory State Pension sources do not establish overlapping payments, other benefits, PIP continuation, full component calculations, deferral or all special groups.","status":"not-established"},{"category":"evidence_closure_unverified","key":"component-calculation","label":"Starting/transitional amount, contracted-out deductions, protected payments, inherited additions and deferral need separate source closure; do not infer one universal qualifying-year rule.","status":"not-established"},{"category":"evidence_closure_unverified","key":"international-records","label":"Foreign contribution aggregation and reduced-rate-election cases need their exact scheme and applicable legal evidence.","status":"not-established"}],"required_unit_keys":["dmg-74022","dmg-74023","dmg-74024","dmg-74101","dmg-74102","dmg-74103","dmg-74151","dmg-74152","dmg-74153","dmg-74154","dmg-74201","dmg-74202","dmg-74204","dmg-74406"],"review_status":"unreviewed-specialist-review-required","scope":"Source-read qualification branches, retaining no-pre-commencement scope, reduced-rate and transitional distinctions and the specifically referenced reduced-rate-election exception. These are selected qualification passages, not a complete formula or all State Pension components.","when_all":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension","https://chris-page-gov.github.io/okf-dwp/id/staff-domain/eligibility"]},{"answerability":"insufficient-until-open-obligations-resolved","assertion_status":"model-derived","covers":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension","https://chris-page-gov.github.io/okf-dwp/id/staff-domain/pip"],"id":"https://chris-page-gov.github.io/okf-dwp/id/requirement/structured/state-pension-pip-scope","label":"State Pension and PIP: different qualifying regimes and PIP age branches","missing_obligations":[{"category":"applicability_unresolved","key":"applicability","label":"Regime, relevant date, territory, claim and claimant facts remain unresolved. Guidance is not an individual entitlement decision.","status":"not-established"},{"category":"legal_version_unreconciled","key":"legal-version","label":"Cited legal sources, amendments and commencement have not been reconciled; captured guidance and illustrative rates are not current-law certification.","status":"not-established"},{"category":"independent_review_pending","key":"specialist-review","label":"Source selection and machine boundaries require specialist review.","status":"not-reviewed"},{"category":"evidence_closure_unverified","key":"task-closure","label":"Introductory State Pension sources do not establish overlapping payments, other benefits, PIP continuation, full component calculations, deferral or all special groups.","status":"not-established"},{"category":"evidence_closure_unverified","key":"pip-age-closure","label":"P4087–P4097 mobility review branches, required periods, residence/presence and the ADP/CDP/PADP exclusion need separate closure. P4080 cites memo6/25 and P1001 memo11/25; their legal effect is unreconciled. The captured P4083 cross-reference is retained without correction.","status":"not-established"},{"category":"evidence_closure_unverified","key":"overlapping-payment","label":"Separate age conditions from receipt/payment interaction; a missing State Pension exclusion in introductory PIP guidance is not by itself proof of unrestricted concurrent awards.","status":"not-established"}],"required_unit_keys":["dmg-74001","adm-p1001","adm-p1011","adm-p1013","adm-p4076-4086"],"review_status":"unreviewed-specialist-review-required","scope":"Source-read comparison of the new State Pension regime with PIP purpose, primary conditions and the retained relevant-age alternatives. Preserve an existing award, a claim made before relevant age and a further claim as different branches. This is not proof of concurrent awards, complete overlap rules, all mobility review branches or an individual outcome.","when_all":["https://chris-page-gov.github.io/okf-dwp/id/staff-domain/state-pension","https://chris-page-gov.github.io/okf-dwp/id/staff-domain/pip"]}],"review_status":"unreviewed-specialist-review-required","schema":"okf-dwp-structured-selection.v1","scope":"Additive source-read State Pension orientation and qualification selections. Keep earlier sources, evidence requirements and open obligations unchanged; do not turn a date-of-birth example into an individual award decision.","source_read_notes":["74001 explicitly distinguishes new State Pension (SP) from retirement pension (RP) and routes the latter to Chapter 75.","74011 names full, reduced and transitional branches; 74012 retains the role of the National Insurance record and HMRC dispute process.","74022 crosses PDF pages 3–4 and routes the 6 April 1960 to 5 March 1961 cohort to Appendix 3. All four referenced appendices are retained with their cohort headings; Appendix 3 includes its end-of-month note. No individual date is calculated and the question wording does not select one table.","74101–03 and 74151–53 have no-pre-commencement scope, so their numerical year conditions must not be generalised to all claimants. 74201–04 preserve the separate transitional branch.","74153 references 74406; that selected passage preserves the special reduced-rate-election exception. 74154 identifies foreign contributions only as a lead, not complete international coordination. Its following printed reserved range remains exact source text with an unresolved machine boundary.","These selections do not establish PIP/State Pension overlap or all additional benefits. Broad State Pension questions receive regime orientation with their substantive interaction obligation left open.","The broad abroad, unqualified SDA-rates and unnamed-benefit care-home questions cannot be made complete merely by attaching one benefit-specific profile; their existing ambiguities remain explicit.","The PIP comparison reuses the exact earlier authored P1011, P1013 and complete P4076–P4086 unit without changing their boundary/completeness labels. Source selection remains model-derived; a complete declared passage is not a complete legal answer.","P1001 describes PIP as an extra-costs daily-living/mobility benefit and routes to transition guidance. P1011 retains its five cumulative gates and devolved-benefit exclusion. P1013 links pensionable age to DMG74022 and four appendices. P4076–P4086 retain continuation/further-claim examples and the unresolved P4083 citation; no overlap conclusion is inferred from silence."],"source_units":[{"boundary_completeness":"unresolved","boundary_status":"machine-detected","document_id":"dmg-vol12-ch74","family":"dmg","id":"https://chris-page-gov.github.io/okf-dwp/id/unit/dmg/dmg-vol12-ch74/manual-structure-v1/source-0000000367-000-2ded2ae44397","key":"dmg-74001","pages_sha256":"c762e93940b4342d70d5bc96a80c3e094c91852d93868f5709e04f293faef61a","paragraph_labels":["74001"],"record_sha256":"12ed4cb88663a79d9d5c9d5ca1687f91561a312b3d6ee749e7747f4071d65dee","review_status":"agent-source-read-selection-only","source_sha256":"5961a9cb7c86814a0f6fa147c0a8a551b4258c803680fac14a95cab9eca1afd6","spans":[{"end_utf8":866,"literal_sha256":"ea2423c9adfff605dd5b6e6b150cedcdf18a19310c855274af97d28f96286c1b","page":1,"start_utf8":367}],"specialist_review":"not-reviewed"},{"boundary_completeness":"unresolved","boundary_status":"machine-detected","document_id":"dmg-vol12-ch74","family":"dmg","id":"https://chris-page-gov.github.io/okf-dwp/id/unit/dmg/dmg-vol12-ch74/manual-structure-v1/source-0000002862-000-cd436c0d6de8","key":"dmg-74011","pages_sha256":"c762e93940b4342d70d5bc96a80c3e094c91852d93868f5709e04f293faef61a","paragraph_labels":["74011"],"record_sha256":"c5081f09080ed208134fee2284b3b3c521e2adc37c1d3cf824975f19f4528cc8","review_status":"agent-source-read-selection-only","source_sha256":"5961a9cb7c86814a0f6fa147c0a8a551b4258c803680fac14a95cab9eca1afd6","spans":[{"end_utf8":284,"literal_sha256":"d66c08863822937e7610d34cf37e4b3f41c8ef93051db1277b0580557367f842","page":3,"start_utf8":0}],"specialist_review":"not-reviewed"},{"boundary_completeness":"unresolved","boundary_status":"machine-detected","document_id":"dmg-vol12-ch74","family":"dmg","id":"https://chris-page-gov.github.io/okf-dwp/id/unit/dmg/dmg-vol12-ch74/manual-structure-v1/source-0000003146-000-84b4e06b0f66","key":"dmg-74012","pages_sha256":"c762e93940b4342d70d5bc96a80c3e094c91852d93868f5709e04f29