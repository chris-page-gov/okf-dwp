    type: source-passage-for-model-proposal
    url:
      https://assets.publishing.service.gov.uk/media/6a5e38bb8b7e4fa537e693d5/dmg-ch84.pdf#page=111
    source_artifact: source/pages/dmg-vol14-ch84.json
    source_sha256: bf1cc65d4b7521b7acb9193a212855e07a88d5a3ef03f5f9eaa74c3c222f39f5
    source_pdf_artifact: source/pdf/dmg-vol14-ch84.pdf
    source_pdf_sha256: f5c610b29bdb81e11736409b7f33ccf7917a4d8945f2821802801073e0d753ee
    source_page_route: page/84/0111
    source_field: pages[110].text
    source_value: "84781 People should be treated as having capital they do not have if they deprive themselves
      of their\n\ncapital for the purpose of getting SPC or more SPC 1. People are not treated as having
      the amount by\n\nwhich notional capital is reduced under the diminishing notional capital rule 2.
      People have not deprived\nthemselves of capital if they disposed of it\n\n\n1. to reduce or pay
      a debt owed by themselves3 or\n\n\n2. to buy goods or services and it was reasonable in their case
      to buy such goods or services 4."
    source_value_sha256: 15f8e676294db6d3ffb230cbbee5eca1b55d842f7bc045a2fd312f9c7766bb0e
    source_value_hash_canonicalization: utf8-verbatim
