    type: source-passage-for-model-proposal
    url:
      https://assets.publishing.service.gov.uk/media/6a5e38bb8b7e4fa537e693d5/dmg-ch84.pdf#page=36
    source_artifact: source/pages/dmg-vol14-ch84.json
    source_sha256: bf1cc65d4b7521b7acb9193a212855e07a88d5a3ef03f5f9eaa74c3c222f39f5
    source_pdf_artifact: source/pdf/dmg-vol14-ch84.pdf
    source_pdf_sha256: f5c610b29bdb81e11736409b7f33ccf7917a4d8945f2821802801073e0d753ee
    source_page_route: page/84/0036
    source_field: pages[35].text
    source_value: "84355 The DM decides if capital can be disregarded. This is done\n\n\n1. before the
      capital is valued as the DM does not have to know the value of the capital to decide if it can\n\
      be disregarded and\n\n\n2. before working out the amount of deemed weekly income from capital.\n\
      \n\nThe DM also decides how long the capital is disregarded and, for certain disregards, whether
      it is\nreasonable to disregard the capital for a longer period."
    source_value_sha256: 8503434900f006e2f87616c93f1d9d999fe26052a1c09aad116455231617fd0d
    source_value_hash_canonicalization: utf8-verbatim
    locator: DMG 84355
    retrieved_at: '2026-09-15T14:21:02Z'
