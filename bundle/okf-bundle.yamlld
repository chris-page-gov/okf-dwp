  - '@id':
      https://chris-page-gov.github.io/okf-dwp/id/evidence/semantic-authoring/66a44335497cce7e0d1160e6136811808c82b70075f07f680fa92b7bedefdbaf
    type: authored-semantic-proposal
    url:
      https://github.com/chris-page-gov/okf-dwp/blob/main/knowledge/concepts/pension-credit.yamlld
    source_artifact: knowledge/concepts/pension-credit.yamlld
    source_sha256: 711fe67f22ef8d5703fc4e10fe70c926ac286e4d16ebc171abf190248e7ffef0
    source_field: term/pension-credit.semantic_relations[1]
    source_value: '{"evidence":[{"locator":"DMG 77001","page":"page/77/0003","quote":"77001 SPC is a SS
      benefit1 that was introduced on 6.10.032. It is made up of\n\n\n1. a GC, to ensure a minimum level
      of income for people who have reached the qualifying age (see DMG\n77330) and\n\n\n2. a SC which,
      from age 65, provides an additional amount for pensioners who have low or modest\nsavings and income
      (see DMG 77350167)."}],"predicate":"http://www.w3.org/2004/02/skos/core#related","rationale":"The
      source describes this component of Pension Credit. Age conditions and historical changes need their
      own temporal review.","target":"term/savings-credit"}'
    source_value_sha256: 9b1ef3ab8a46987e1795680ccfc60247b58c0b13a1290c511679ea276bee2b36
    source_value_hash_canonicalization: utf8-verbatim
    locator: term/pension-credit
    rationale: The source describes this component of Pension Credit. Age conditions and historical
      changes need their own temporal review.
    retrieved_at: '2026-09-15T16:57:46Z'
  - '@id':
      https://chris-page-gov.github.io/okf-dwp/id/evidence/semantic-passage/66a44335497cce7e0d1160e6136811808c82b70075f07f680fa92b7bedefdbaf/0
    type: source-passage-for-model-proposal
    url: https://assets.publishing.service.gov.uk/media/68401a731d85c6606009cce4/dmgch77.pdf#page=3
    source_artifact: source/pages/dmg-vol13-ch77.json
    source_sha256: f7c34c30310a5e1f4700fb00b291e2bdec89554a89d4c244a9762c16c7448f19
    source_pdf_artifact: source/pdf/dmg-vol13-ch77.pdf
    source_pdf_sha256: 0528f2fb95ac3bd71bdff0d91cdaba5df76ab4260396ca99608c840004ff5708
    source_page_route: page/77/0003
    source_field: pages[2].text
    source_value: "77001 SPC is a SS benefit1 that was introduced on 6.10.032. It is made up of\n\n\n\
      1. a GC, to ensure a minimum level of income for people who have reached the qualifying age (see
      DMG\n77330) and\n\n\n2. a SC which, from age 65, provides an additional amount for pensioners who
      have low or modest\nsavings and income (see DMG 77350167)."
    source_value_sha256: 19516daef760ea4b29be6630232a49fcc84499b48b61e786ce05be914dded308
    source_value_hash_canonicalization: utf8-verbatim
    locator: DMG 77001
