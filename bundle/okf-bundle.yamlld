    type: source-passage-for-model-proposal
    url: https://assets.publishing.service.gov.uk/media/68401a731d85c6606009cce4/dmgch77.pdf#page=3
    source_artifact: source/pages/dmg-vol13-ch77.json
    source_sha256: f7c34c30310a5e1f4700fb00b291e2bdec89554a89d4c244a9762c16c7448f19
    source_pdf_artifact: source/pdf/dmg-vol13-ch77.pdf
    source_pdf_sha256: 0528f2fb95ac3bd71bdff0d91cdaba5df76ab4260396ca99608c840004ff5708
    source_page_route: page/77/0003
    source_field: pages[2].text
    source_value: "77001 SPC is a SS benefit1 that was introduced on 6.10.032. It is made up of\n\n\n\
      1. a GC, to ensure a minimum level of income for people who have reached the qualifying age (see
      DMG\n77330) and\n\n\n2. a SC which, from age 65, provides an additional amount for pensioners who
      have low or modest\nsavings and income (see DMG 77350167)."
    source_value_sha256: 19516daef760ea4b29be6630232a49fcc84499b48b61e786ce05be914dded308
    source_value_hash_canonicalization: utf8-verbatim
    locator: DMG 77001
    retrieved_at: '2026-09-15T14:21:01Z'
