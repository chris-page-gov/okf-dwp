    source_field: term/capital-disregards.semantic_relations[2]
    source_value: '{"evidence":[{"locator":"DMG 84356","page":"page/84/0036","quote":"84356 Capital which
      can be disregarded is disregarded for1\n\n\n1. an indefinite period (DMG 84367 et seq) or\n\n\n2.
      up to two years (DMG 84521 et seq) or\n\n\n3. a year or longer (DMG 84561 et seq) or\n\n\n4. 26
      weeks or longer (DMG 84601 et seq) or\n\n\n5. the remainder of an award of SPC (DMG 84671 et seq)."}],"predicate":"https://chris-page-gov.github.io/okf-dwp/ns#hasDisregardPeriod","rationale":"The
      source separates duration categories from the existence of a disregard; no default duration is assigned.","target":"term/capital-disregard-period"}'
