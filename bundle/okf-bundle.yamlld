    source_sha256: bf1cc65d4b7521b7acb9193a212855e07a88d5a3ef03f5f9eaa74c3c222f39f5
    source_pdf_artifact: source/pdf/dmg-vol14-ch84.pdf
    source_pdf_sha256: f5c610b29bdb81e11736409b7f33ccf7917a4d8945f2821802801073e0d753ee
    source_page_route: page/84/0036
    source_field: pages[35].text
    source_value: "84356 Capital which can be disregarded is disregarded for1\n\n\n1. an indefinite period
      (DMG 84367 et seq) or\n\n\n2. up to two years (DMG 84521 et seq) or\n\n\n3. a year or longer (DMG
      84561 et seq) or\n\n\n4. 26 weeks or longer (DMG 84601 et seq) or\n\n\n5. the remainder of an award
      of SPC (DMG 84671 et seq)."
    source_value_sha256: 3235a09b5e1dcb74ed20fdcbc77f96dab54dc66789b15869f558abd1b60451a3
