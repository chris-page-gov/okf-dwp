    source_field: term/pension-credit.semantic_relations[0]
    source_value: '{"evidence":[{"locator":"DMG 77001","page":"page/77/0003","quote":"77001 SPC is a SS
      benefit1 that was introduced on 6.10.032. It is made up of\n\n\n1. a GC, to ensure a minimum level
      of income for people who have reached the qualifying age (see DMG\n77330) and\n\n\n2. a SC which,
      from age 65, provides an additional amount for pensioners who have low or modest\nsavings and income
      (see DMG 77350167)."}],"predicate":"http://www.w3.org/2004/02/skos/core#related","rationale":"The
      source describes this component of Pension Credit. Age conditions and historical changes need their
      own temporal review.","target":"term/guarantee-credit"}'
