  applicable_plane_roots:
    source: 9bcba9a8e379670c16542802709ffbe5b7151340e81a2172cbf3f97e0b33af9a
    semantic: fc4150092d61cdbb681b278a7a2cb8df827eb21314e4bddeefb25f3ba25c5ccb
    data: 47ccd2d37df55bf89f1765a196d216851a9b0b68060b41f2efbae81c7ffaece4
    search: 46c8f866c9e3c4e033d75faa573eaad3410591aa070a9c95c75e2420db710dd0
