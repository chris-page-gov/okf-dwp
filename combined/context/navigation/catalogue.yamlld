'@context':
  skos: http://www.w3.org/2004/02/skos/core#
  dcterms: http://purl.org/dc/terms/
  schema: https://schema.org/
  nav: https://chris-page-gov.github.io/okf-dwp/ns/navigation#
  dimension: nav:dimension
  match:
    '@id': nav:literalMatchingRule
    '@type': '@json'
  review_status: nav:reviewStatus
  scope: skos:scopeNote
schema: okf-dwp-navigation-rules.v1
method: whole-word-whitespace-flexible-literal-v1
policy:
  authority: project-authored navigation rules; specialist review required
  assertion: A literal is present in extracted text. This does not mean the guidance applies to that
    benefit or person.
  short_abbreviations: 'IS, PC, SP, CA, AA and SDA deliberately excluded: ambiguous abbreviations require
    separate resolution.'
  unmatched: Keep an explicit Not classified value per dimension. Absence of a tag is not evidence
    of absence.
  source_scope: Frozen DMG 15 September 2026 and ADM 19 September 2026; no source refresh.
'@graph':
- '@id': https://chris-page-gov.github.io/okf-dwp/id/navigation/scheme
  '@type': skos:ConceptScheme
  skos:prefLabel:
    '@value': DWP evidence navigation labels
    '@language': en-GB
  dcterms:description: Project-authored discovery labels over frozen machine-extracted text; not an
    official departmental ontology.
