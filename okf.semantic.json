{
  "schema": "okf-repository-semantic-contract.v1",
  "repository": {
    "name": "okf-dwp",
    "role": "governed-producer",
    "root_index": "README.md"
  },
  "okf_core": {
    "version": "0.2",
    "specification": "https://github.com/GoogleCloudPlatform/knowledge-catalog/blob/main/okf/SPEC.md",
    "status": "conformant"
  },
  "semantic_layer": {
    "profile": "https://chris-page-gov.github.io/okf-explorer/profile/bundle-wiki/v1/",
    "state": "generated-yaml-ld-assertion-graph",
    "authoritative_inputs": [
      "knowledge/**/*.yamlld",
      "source/inventory.json",
      "source/pages/*.json",
      "source/full-dmg-2026-09-15/inventory.json",
      "source/full-dmg-2026-09-15/pages/*.json",
      "source/adm-2026-09-19/inventory.json",
      "source/adm-2026-09-19/pages/*.json",
      "context/corpus-sources.json",
      "domain-profile/navigation/*.yamlld",
      "domain-profile/staff-semantic/*.yamlld",
      "domain-profile/legal-reconciliation/*.yamlld",
      "domain-profile/legal-reconciliation/seeds.json",
      "domain-profile/staff-needs/journeys.json",
      "source/legal-discovery-2026-09-20/manifest.json"
    ],
    "outputs": [
      {
        "path": "bundle/okf-bundle.yamlld",
        "role": "semantic-yaml-ld",
        "generated": true
      },
      {
        "path": "bundle/okf-bundle.jsonld",
        "role": "semantic-json-ld",
        "generated": true
      },
      {
        "path": "bundle/okf-bundle.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "bundle/relationships.json",
        "role": "relationship-runtime",
        "generated": true
      },
      {
        "path": "full-dmg/okf-explorer.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "full-dmg/okf-corpus-context.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "full-dmg/okf-bundle.yamlld",
        "role": "semantic-yaml-ld",
        "generated": true
      },
      {
        "path": "full-dmg/okf-bundle.jsonld",
        "role": "semantic-json-ld",
        "generated": true
      },
      {
        "path": "full-dmg/data/semantic/manifest.json",
        "role": "semantic-manifest",
        "generated": true
      },
      {
        "path": "full-dmg/data/semantic/*.jsonld.gz",
        "role": "semantic-json-ld-shards",
        "generated": true
      },
      {
        "path": "full-dmg/data/relationships-*.json.gz",
        "role": "relationship-runtime",
        "generated": true
      },
      {
        "path": "context/discovery/assembly-index.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "context/discovery/manifest.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "context/corpus/manifest.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "context/corpus/base-index.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "full-dmg/okf-review-context.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "full-dmg/context/navigation/catalogue.yamlld",
        "role": "semantic-yaml-ld",
        "generated": true
      },
      {
        "path": "evaluation/semantic-expansion/assembly-index.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "combined/okf-explorer.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "combined/context/corpus/manifest.json",
        "role": "explorer-runtime",
        "generated": true
      },
      {
        "path": "combined/data/relationships-*.json.gz",
        "role": "relationship-runtime",
        "generated": true
      },
      {
        "path": "combined/okf-bundle.yamlld",
        "role": "semantic-yaml-ld",
        "generated": true
      },
      {
        "path": "combined/okf-bundle.jsonld",
        "role": "semantic-json-ld",
        "generated": true
      },
      {
        "path": "combined/data/semantic/manifest.json",
        "role": "semantic-manifest",
        "generated": true
      },
      {
        "path": "combined/data/semantic/*.jsonld.gz",
        "role": "semantic-json-ld-shards",
        "generated": true
      }
    ],
    "context_policy": "pinned-local-contexts-no-browser-remote-expansion",
    "identity_policy": "absolute-semantic-iri-plus-validated-local-route",
    "limitations": [
      "Independent experimental source discovery; no specialist legal review or full Foundry production assurance.",
      "Authored references are navigation; explicit semantic relations are source-backed model proposals awaiting specialist review. PDF page containment is deterministically derived.",
      "Machine extraction has known defects. Full-DMG search includes clearly labelled historical amendments; the preserved Pension Credit pilot keeps them outside its default page search.",
      "ADM is a separate frozen source family. Corpus-wide page retrieval does not establish complete policy modelling or an answerability profile.",
      "The preserved custody context and its immutable acceptance receipts retain their original source and consumer versions.",
      "The additive combined Reader and staff semantic projection preserve earlier releases. Forty development profiles contain named unmet obligations; none establishes a complete answer or independent specialist acceptance.",
      "Verified provision reference metadata is navigation only. It does not contain statutory body evidence or establish commencement, extent for an individual case, or legal applicability."
    ]
  },
  "relationship_contract": {
    "schema": "https://chris-page-gov.github.io/okf-explorer/profile/bundle-wiki/v1/semantic-assertion.schema.json",
    "authoring": "generated-yaml-ld-assertion-graph",
    "direct_triple_policy": "generated-from-one-assertion-source",
    "predicate_policy": "absolute-iri",
    "required_fields": [
      "id",
      "source",
      "target",
      "source_iri",
      "target_iri",
      "predicate",
      "kind",
      "label",
      "inverse_label",
      "assertion_status",
      "assertion_scope",
      "authority",
      "derivation",
      "observed_at",
      "evidence",
      "rights"
    ]
  },
  "tooling": {
    "setup": [
      "uv sync --locked"
    ],
    "build": [
      "uv run --locked python scripts/build_bundle.py",
      "uv run --locked python scripts/build_full_dmg.py",
      "uv run --locked python scripts/build_context_discovery.py",
      "uv run --locked python scripts/build_context_corpus.py",
      "uv run --locked python scripts/build_review_navigation.py",
      "uv run --locked python scripts/build_staff_review_packs.py",
      "uv run --locked python scripts/build_staff_needs.py",
      "uv run --locked python scripts/build_legal_reconciliation.py",
      "uv run --locked python scripts/build_staff_semantic.py",
      "uv run --locked python scripts/build_combined_reader.py",
      "uv run --locked python scripts/compare_source_census.py"
    ],
    "check": [
      "uv run --locked python scripts/check_semantic_contract.py",
      "uv run --locked python scripts/build_bundle.py --check",
      "uv run --locked python scripts/validate_bundle.py",
      "uv run --locked python scripts/build_full_dmg.py --check",
      "uv run --locked python scripts/validate_full_dmg.py",
      "uv run --locked python scripts/report_full_dmg_coverage.py --check",
      "node --experimental-strip-types scripts/check_full_dmg_consumer.mjs",
      "uv run --locked python scripts/evaluate_full_dmg.py --check",
      "uv run --locked python scripts/reconcile_full_dmg_references.py --check",
      "uv run --locked python scripts/verify_full_dmg_trials.py --check",
      "uv run --locked python scripts/acquire_adm.py --check",
      "uv run --locked python scripts/build_context_discovery.py --check",
      "uv run --locked python scripts/build_context_corpus.py --check",
      "uv run --locked python scripts/audit_relationships.py --check",
      "uv run --locked python scripts/check_private_inputs.py",
      "uv run --locked python scripts/build_review_navigation.py --check",
      "uv run --locked python scripts/build_staff_review_packs.py --check",
      "uv run --locked python scripts/build_staff_needs.py --check",
      "uv run --locked python scripts/build_legal_reconciliation.py --check",
      "uv run --locked python scripts/build_staff_semantic.py --check",
      "uv run --locked python scripts/build_combined_reader.py --check",
      "uv run --locked python scripts/compare_source_census.py --check",
      "uv run --locked python scripts/check_combined_reader_observations.py"
    ]
  },
  "reader": {
    "consumer": "https://chris-page-gov.github.io/okf-explorer/",
    "delivery": "yaml-ld-small-graph",
    "preserves": [
      "direction",
      "semantic-identities",
      "local-routes",
      "predicate",
      "relationship-kind",
      "preferred-and-inverse-labels",
      "assertion-status-and-scope",
      "authority",
      "derivation",
      "supporting-assertions",
      "confidence",
      "review-status",
      "evidence",
      "rights",
      "freshness",
      "lifecycle"
    ]
  }
}
