  "target": "ukpga/2002/16/section/4",
  "units": [
    {
      "ancestor_headings_nearest_first": [
        "Exclusions",
        "State pension credit: entitlement and amount"
      ],
      "body_text": "4\n1\nA claimant is not entitled to state pension credit if he is a member of a couple the other member of which is entitled to state pension credit.\n1A\nA claimant is not entitled to state pension credit if he is a member of a couple the other member of which has not attained the qualifying age.\n2\nIn section 115(1) of the Immigration and Asylum Act 1999 (c. 33) (exclusion of certain persons from benefits) in the words preceding paragraph (a), after “Jobseekers Act 1995” insert “ or to state pension credit under the State Pension Credit Act 2002 ”.\n3\nWhere the amount payable by way of state pension credit would (apart from this subsection) be less than a prescribed amount, it shall not be payable except in prescribed circumstances.",
      "body_text_sha256": "90f0c88f8918d15bbff305159d96506be88377dd526649204a086e5cb0bf33f6",
