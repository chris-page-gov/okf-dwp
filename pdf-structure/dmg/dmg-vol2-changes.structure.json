37. ","tree_line_end":170,"tree_line_start":169},{"depth":1,"role":"H1","text":" ","tree_line_end":172,"tree_line_start":171},{"depth":1,"role":"H1","text":"February 2023 updates ","tree_line_end":174,"tree_line_start":173},{"depth":1,"role":"H1","text":" ","tree_line_end":176,"tree_line_start":175},{"depth":1,"role":"H1","text":"Chapter 7 Part 2 ","tree_line_end":178,"tree_line_start":177},{"depth":1,"role":"H1","text":"Minor changes due to the removal of typos.   ","tree_line_end":180,"tree_line_start":179},{"depth":1,"role":"H1","text":" ","tree_line_end":182,"tree_line_start":181},{"depth":1,"role":"H1","text":"December 2022 updates ","tree_line_end":184,"tree_line_start":183},{"depth":1,"role":"H1","text":" ","tree_line_end":186,"tree_line_start":185},{"depth":1,"role":"H1","text":"Chapter 7 Part 2 ","tree_line_end":188,"tree_line_start":187},{"depth":1,"role":"H1","text":"Various typos within chapter corrected.   ","tree_line_end":190,"tree_line_start":189},{"depth":1,"role":"H1","text":" ","tree_line_end":192,"tree_line_start":191},{"depth":1,"role":"H1","text":"October 2022 updates ","tree_line_end":194,"tree_line_start":193},{"depth":1,"role":"H1","text":" ","tree_line_end":196,"tree_line_start":195},{"depth":1,"role":"H1","text":"Chapter 7 Part 3 ","tree_line_end":198,"tree_line_start":197},{"depth":1,"role":"P","text":"Minor change to paragraph 073246 to remove obsolete wording. ","tree_line_end":200,"tree_line_start":199},{"depth":1,"role":"H1","text":" ","tree_line_end":202,"tree_line_start":201},{"depth":1,"role":"H1","text":"August 2022 updates ","tree_line_end":204,"tree_line_start":203},{"depth":1,"role":"H1","text":" ","tree_line_end":206,"tree_line_start":205},{"depth":1,"role":"H1","text":"Chapter 7 Part 2 ","tree_line_end":208,"tree_line_start":207},{"depth":1,"role":"P","text":"Update made to wording in paragraph 071721.\n ","tree_line_end":211,"tree_line_start":209},{"depth":1,"role":"H1","text":" ","tree_line_end":213,"tree_line_start":212},{