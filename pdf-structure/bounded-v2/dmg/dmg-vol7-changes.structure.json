{"blocks":[{"depth":1,"role":"H1","text":"\nDMG - Volume 7: JSA & IS  ","tree_line_end":4,"tree_line_start":2},{"depth":1,"role":"H1","text":"\nChapters 36 - 40 ","tree_line_end":7,"tree_line_start":5},{"depth":1,"role":"P","text":"Summary of changes from December 2020 ","tree_line_end":9,"tree_line_start":8},{"depth":1,"role":"P","text":" ","tree_line_end":11,"tree_line_start":10},{"depth":1,"role":"P","text":"July 2026 updates ","tree_line_end":13,"tree_line_start":12},{"depth":1,"role":"P","text":" ","tree_line_end":15,"tree_line_start":14},{"depth":1,"role":"H1","text":"Chapter 39 ","tree_line_end":17,"tree_line_start":16},{"depth":1,"role":"P","text":"“CAS” (Carer’s Allowance Supplement) and “YCG” (Young Carer Grant) added to Appendix 1: Benefits excluded from being assets of the deceased as at the date of death (see DMG 39408). ","tree_line_end":19,"tree_line_start":18},{"depth":1,"role":"P","text":" ","tree_line_end":21,"tree_line_start":20},{"depth":1,"role":"P","text":"November 2025 updates ","tree_line_end":23,"tree_line_start":22},{"depth":1,"role":"P","text":" ","tree_line_end":25,"tree_line_start":24},{"depth":1,"role":"P","text":"Chapter 39 ","tree_line_end":27,"tree_line_start":26},{"depth":1,"role":"P","text":" ","tree_line_end":29,"tree_line_start":28},{"depth":1,"role":"P","text":"DMG Chapter 39: Social Fund amendment by addition of a Note in para 39169 and a new illustrative example 2. ","tree_line_end":31,"tree_line_start":30},{"depth":1,"role":"P","text":" ","tree_line_end":33,"tree_line_start":32},{"depth":1,"role":"H1","text":"September 2025 updates ","tree_line_end":35,"tree_line_start":34},{"depth":1,"role":"H1","text":" ","tree_line_end":37,"tree_line_start":36},{"depth":1,"role":"H1","text":"Chapter 39 ","tree_line_end":39,"tree_line_start":38},{"depth":1,"role":"H1","text":" ","tree_line_end":41,"tree_line_start":40},{"depth":1,"role":"H1","text":"DMG Chapter 39: Social Fund (Winter Fuel Payments 39900–39999)  ","tree_line_end":43,"tree_line_start":42},{"depth":1,"role":"P","text":"The guidance for Winter Fuel Payments (39900–39999) in Chapter 39 has been fully updated to reflect the new 2025 Regulations. ","tree_line_end":45,"tree_line_start":44},{"depth":1,"role":"H1","text":" ","tree_line_end":47,"tree_line_start":46},{"depth":1,"role":"H1","text":"Chapter 40: Winter Fuel Payments (pre–Winter 2025). ","tree_line_end":49,"tree_line_start":48},{"depth":1,"role":"P","text":"Guidance on Winter Fuel Payments pre–Winter 2025 has been added to archive the guidance relating to the revoked 2024 Regulations. ","tree_line_end":51,"tree_line_start":50},{"depth":1,"role":"H1","text":" ","tree_line_end":53,"tree_line_start":52},{"depth":1,"role":"P","text":"DMG SI Abbreviations amended to include SI2025/969  ","tree_line_end":55,"tree_line_start":54},{"depth":1,"role":"H1","text":" ","tree_line_end":57,"tree_line_start":56},{"depth":1,"role":"H1","text":"September 2024 updates ","tree_line_end":59,"tree_line_start":58},{"depth":1,"role":"H1","text":" ","tree_line_end":61,"tree_line_start":60},{"depth":1,"role":"H1","text":"Chapter 39 ","tree_line_end":63,"tree_line_start":62},{"depth":1,"role":"P","text":" ","tree_line_end":65,"tree_line_start":64},{"depth":1,"role":"P","text":"Guidance on Winter Fuel Payments at paragraphs 39900 – 39999 has been updated to reflect new Legislation (SI 2024/869) ","tree_line_end":67,"tree_line_start":66},{"depth":1,"role":"P","text":" ","tree_line_end":69,"tree_line_start":68},{"depth":1,"role":"P","text":"The former Appendices 4 & 5 have been relocated and can now be found in the retitled DMG chapter 40: Winter Fuel Payments Pre- Winter 2024 ","tree_line_end":71,"tree_line_start":70},{"depth":1,"role":"P","text":" ","tree_line_end":73,"tree_line_start":72},{"depth":1,"role":"H1","text":"Chapter 40 ","tree_line_end":75,"tree_line_start":74},{"depth":1,"role":"H1","text":" ","tree_line_end":77,"tree_line_start":76},{"depth":1,"role":"H1","text":"This is a new Chapter and contains guidance on Winter Fuel Payments pre-winter 2024 (the now revoked 2000 Regs). ","tree_line_end":79,"tree_line_start":78},{"depth":1,"role":"H1","text":" ","tree_line_end":81,"tree_line_start":80},{"depth":1,"role":"P","text":" ","tree_line_end":83,"tree_line_start":82},{"depth":1,"role":"H1","text":"January 2024 updates ","tree_line_end":85,"tree_line_start":84},{"depth":1,"role":"H1","text":" ","tree_line_end":87,"tree_line_start":86},{"depth":1,"role":"H1","text":"Chapter 39  ","tree_line_end":89,"tree_line_start":88},{"depth":1,"role":"H1","text":"Updated DMG 39301 & 2 slightly, for clarification and added two examples. ","tree_line_end":91,"tree_line_start":90},{"depth":1,"role":"H1","text":" ","tree_line_end":93,"tree_line_start":92},{"depth":1,"role":"H1","text":"August 2023 updates ","tree_line_end":95,"tree_line_start":94},{"depth":1,"role":"H1","text":" ","tree_line_end":97,"tree_line_start":96},{"depth":1,"role":"H1","text":"Chapter 39  ","tree_line_end":99,"tree_line_start":98},{"depth":1,"role":"H1","text":"Amended DMG Chapter 39 – para 39900 onwards. This is to include guidance on temporary increases for specific winters for Winter Fuel Payments ","tree_line_end":101,"tree_line_start":100},{"depth":1,"role":"H1","text":" ","tree_line_end":103,"tree_line_start":102},{"depth":1,"role":"H1","text":"January 2023 updates ","tree_line_end":105,"tree_line_start":104},{"depth":1,"role":"H1","text":" ","tree_line_end":107,"tree_line_start":106},{"depth":1,"role":"H1","text":"Chapter 39  ","tree_line_end":109,"tree_line_start":108},{"depth":1,"role":"P","text":"Deleted the example at paragraph 39413. Deleted paragraph 39414 following policy clarification back in November and this example related to that paragraph.\n ","tree_line_end":112,"tree_line_start":110},{"depth":1,"role":"H1","text":" ","tree_line_end":114,"tree_line_start":113},{"depth":1,"role":"H1","text":"Chapter 39  ","tree_line_end":116,"tree_line_start":115},{"depth":1,"role":"H1","text":"\nAppendix 5 - Phasing table for Winter Fuel Payments brought up to date. ","tree_line_end":119,"tree_line_start":117},{"depth":1,"role":"H1","text":" ","tree_line_end":121,"tree_line_start":120},{"depth":1,"role":"H1","text":"November 2022 updates ","tree_line_end":123,"tree_line_start":122},{"depth":1,"role":"H1","text":" ","tree_line_end":125,"tree_line_start":124},{"depth":1,"role":"H1","text":"Chapter 39  ","tree_line_end":127,"tree_line_start":126},{"depth":1,"role":"H1","text":"\nIncorporated Memo DMG 12-21. ","tree_line_end":130,"tree_line_start":128},{"depth":1,"role":"H1","text":" ","tree_line_end":132,"tree_line_start":131},{"depth":1,"role":"H1","text":"Chapter 39  ","tree_line_end":134,"tree_line_start":133},{"depth":1,"role":"P","text":"\nMinor amendments. New wording for paragraph 39413 - Any benefit paid into the deceased’s account on or after the date of death is not included in the assets of the deceased and does not reduce the award of a funeral payment. ","tree_line_end":137,"tree_line_start":135},{"depth":1,"role":"P","text":"\nParagraph 39414 is deleted, as is the Appendix 3 for Chapter 39. ","tree_line_end":140,"tree_line_start":138},{"depth":1,"role":"P","text":" ","tree_line_end":142,"tree_line_start":141},{"depth":1,"role":"H1","text":"December 2021 updates ","tree_line_end":144,"tree_line_start":143},{"depth":1,"role":"H1","text":" ","tree_line_end":146,"tree_line_start":145},{"depth":1,"role":"H1","text":"Chapter 39 ","tree_line_end":148,"tree_line_start":147},{"depth":1,"role":"H1","text":"Reference to “Agents, Appointees, Attorneys and Deputies guide” at para. 39149 amended to “Agents, appointees, attorneys, deputies and third parties: staff guide”. ","tree_line_end":150,"tree_line_start":149},{"depth":1,"role":"H1","text":" ","tree_line_end":152,"tree_line_start":151},{"depth":1,"role":"H1","text":"July 2021 updates ","tree_line_end":154,"tree_line_start":153},{"depth":1,"role":"H1","text":" ","tree_line_end":156,"tree_line_start":155},{"depth":1,"role":"H1","text":"Chapter 39 ","tree_line_end":158,"tree_line_start":157},{"depth":1,"role":"H1","text":"Re-order and re-written for clarification ","tree_line_end":160,"tree_line_start":159},{"depth":1,"role":"H1","text":" ","tree_line_end":162,"tree_line_start":161},{"depth":1,"role":"H1","text":"February 2021 updates ","tree_line_end":164,"tree_line_start":163},{"depth":1,"role":"H1","text":" ","tree_line_end":166,"tree_line_start":165},{"depth":1,"role":"H1","text":"Chapter 39 ","tree_line_end":168,"tree_line_start":167},{"depth":1,"role":"H1","text":"Minor amendments ","tree_line_end":170,"tree_line_start":169},{"depth":1,"role":"H1","text":" ","tree_line_end":172,"tree_line_start":171},{"depth":1,"role":"H1","text":"Chapter 39 ","tree_line_end":174,"tree_line_start":173},{"depth":1,"role":"H1","text":"Guidance at 39102 updated to reflect EU Exit related changes. ","tree_line_end":176,"tree_line_start":175},{"depth":1,"role":"H1","text":" ","tree_line_end":178,"tree_line_start":177},{"depth":1,"role":"H1","text":"December 2020 updates ","tree_line_end":180,"tree_line_start":179},{"depth":1,"role":"H1","text":" ","tree_line_end":182,"tree_line_start":181},{"depth":1,"role":"P","text":"Chapter 39 ","tree_line_end":184,"tree_line_start":183},{"depth":1,"role":"P","text":"‘Funeral Expenses’ includes clarification of Discounts, and the guidance for Cold Weather Payments is now located in Advice for Decision Makers’ Chapter L4 – that chapter now covers all qualifying benefits. ","tree_line_end":186,"tree_line_start":185},{"depth":1,"role":"P","text":" ","tree_line_end":188,"tree_line_start":187}],"bounds":{"stderr_bytes":65536,"stdout_bytes":16777216,"timeout_seconds":45},"command":["/opt/homebrew/bin/pdfinfo","-struct-text","source/full-dmg-2026-09-15/pdf/dmg-vol7-changes.pdf"],"diagnostics":{"roles_not_emitted":{"Document":1},"text_joiner":"\n","tree_lines":188,"unparsed_line_count":0,"unparsed_line_samples":[],"unparsed_line_samples_omitted":0},"document_id"