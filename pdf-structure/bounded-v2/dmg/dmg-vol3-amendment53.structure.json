{"blocks":[{"depth":1,"role":"P","text":"Department for Work and Pensions","tree_line_end":6,"tree_line_start":2},{"depth":1,"role":"P","text":"DECISION MAKING AND APPEALS (PART OF LEGAL GROUP)","tree_line_end":10,"tree_line_start":7},{"depth":1,"role":"P","text":"","tree_line_end":14,"tree_line_start":11},{"depth":1,"role":"H1","text":"Decision Makers Guide ","tree_line_end":18,"tree_line_start":15},{"depth":1,"role":"P","text":"","tree_line_end":21,"tree_line_start":19},{"depth":1,"role":"H2","text":"Volume 3 ","tree_line_end":25,"tree_line_start":22},{"depth":1,"role":"P","text":"Amendment 53 – June 2017","tree_line_end":29,"tree_line_start":26},{"depth":1,"role":"P","text":"","tree_line_end":33,"tree_line_start":30},{"depth":1,"role":"P","text":"1.This letter provides details on Amendment 53; the changes have already beenincorporated in to the Intranet and Internet versions of the DMG.","tree_line_end":39,"tree_line_start":34},{"depth":1,"role":"P","text":"","tree_line_end":44,"tree_line_start":40},{"depth":1,"role":"P","text":"2.PDF amendment packages are also available. These can be printed with theamended pages being reproduced in full. Each page will contain theamendment number in the footer","tree_line_end":50,"tree_line_start":45},{"depth":1,"role":"P","text":"","tree_line_end":55,"tree_line_start":51},{"depth":1,"role":"P","text":"PDF amendment packages can be found on the Intranet at:","tree_line_end":60,"tree_line_start":56},{"depth":1,"role":"P","text":"","tree_line_end":65,"tree_line_start":61},{"depth":1,"role":"P","text":"http://intralink/1/lg/acileeds/guidance/decision%20makers%20guide/index.asp\n","tree_line_end":77,"tree_line_start":66},{"depth":1,"role":"P","text":"","tree_line_end":82,"tree_line_start":78},{"depth":1,"role":"P","text":"or on the Internet at the ‘Amdt Packages’ tab on the following link:","tree_line_end":86,"tree_line_start":83},{"depth":1,"role":"P","text":"","tree_line_end":90,"tree_line_start":87},{"depth":1,"role":"P","text"