{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "type": "string",
      "maxLength": 256
    },
    "package_evidence_status": {
      "type": "string",
      "enum": [
        "insufficient"
      ]
    },
    "answer_disposition": {
      "type": "string",
      "enum": [
        "partial_evidence_only",
        "cannot_establish"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1400,
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "statement": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "record_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "quote": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 1200
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "record_id",
                "quote",
                "source_url",
                "locator"
              ]
            }
          },
          "scope_or_qualification": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "evidence",
          "scope_or_qualification"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "maxItems": 8
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "maxItems": 8
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "minItems": 1,
      "maxItems": 8
    },
    "case_id": {
      "type": "string",
      "enum": [
        "control-unknown",
        "staff-012"
      ]
    }
  },
  "required": [
    "case_id",
    "context_id",
    "package_evidence_status",
    "answer_disposition",
    "summary",
    "claims",
    "gaps",
    "abstentions",
    "limitations"
  ]
}
