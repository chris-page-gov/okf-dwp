{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_id": {
      "type": "string"
    },
    "package_evidence_status": {
      "type": "string",
      "enum": [
        "sufficient",
        "insufficient",
        "conflicting"
      ]
    },
    "answer_disposition": {
      "type": "string",
      "enum": [
        "bounded_source_answer",
        "partial_evidence_only",
        "cannot_establish"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 3500
    },
    "claims": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "maxLength": 1800
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "record_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 1200
                },
                "source_url": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                }
              },
              "required": [
                "record_id",
                "quote",
                "source_url",
                "locator"
              ]
            }
          },
          "scope_or_qualification": {
            "type": "string",
            "maxLength": 1800
          }
        },
        "required": [
          "id",
          "statement",
          "evidence",
          "scope_or_qualification"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": [
    "context_id",
    "package_evidence_status",
    "answer_disposition",
    "summary",
    "claims",
    "gaps",
    "abstentions",
    "limitations"
  ]
}
