  semantic_relations:
  - target: term/intl-ni-presence
    predicate: http://www.w3.org/2004/02/skos/core#related
    rationale: The stated cross-border procedure requires more than casual presence and retains explicit benefit exclusions.
    evidence:
    - page: page/dmg-vol2-ch7-part1/0098
      quote: "070531 For a revision, supersession or appeal to take place in the other country, the person must be \"in\"\n\nthat country. A casual presence is not enough1.\n\n\n                                                                                               1 R(S) 5/85"
      locator: DMG 070531
    - page: page/dmg-vol2-ch7-part1/0098
      quote: "070533 The agreement applies to most benefits however reviews or appeals cannot be undertaken for\nUC, Pension Credit, Christmas Bonus, Income Support, Social Fund (maternity and funeral expenses),\nFamily Credit, Statutory Sick Pay or Statutory Maternity Pay."
      locator: DMG 070533
